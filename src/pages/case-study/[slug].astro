---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { caseStudies } from "../../data/caseStudies";

interface Stat {
	value: string;
	label: string;
}
interface GalleryImage {
	src: string;
	alt: string;
	caption?: string;
}
interface PaidPage {
	name: string;
	url: string;
	tag: string;
	description: string;
}
interface PaidAcquisitionSection {
	headline: string;
	body: string;
	pages: PaidPage[];
}
interface VideoSiteLink {
	url: string;
	label: string;
	description: string;
}
interface VideoSection {
	label: string;
	headline: string;
	body: string;
	videoSrc: string;
	posterSrc: string;
	watchLabel?: string;
	siteLink?: VideoSiteLink;
}
interface CaseStudy {
	slug: string;
	client: string;
	title: string;
	tagline: string;
	heroImage: string;
	heroObjectPosition?: string;
	tags: string[];
	organization: string;
	challenge: string;
	challengePoints?: string[];
	approach: string;
	approachPoints?: string[];
	results: string;
	resultsExtra?: string;
	stats: Stat[];
	galleryImages?: GalleryImage[];
	paidAcquisitionSection?: PaidAcquisitionSection;
	videoSection?: VideoSection;
	detailedStatsHeadline?: string;
	detailedStats?: Stat[];
	detailedStatsFootnote?: string;
}

const allStudies = caseStudies as unknown as CaseStudy[];

export function getStaticPaths() {
	const studies = caseStudies as unknown as CaseStudy[];
	return studies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props as { study: CaseStudy };

const toImagePath = (p: string) => p.replace(/^\//, "/images/");
const toVideoPath = (p: string) => p.replace(/^\//, "/videos/");

const heroImage = toImagePath(study.heroImage);
const galleryImages = (study.galleryImages ?? []).map((g) => ({ ...g, src: toImagePath(g.src) }));
const videoSection = study.videoSection
	? {
			...study.videoSection,
			videoSrc: toVideoPath(study.videoSection.videoSrc),
			posterSrc: toImagePath(study.videoSection.posterSrc),
		}
	: undefined;

const otherStudies = allStudies.filter((cs) => cs.slug !== study.slug);

const pageUrl = `https://ascendsmartly.com/case-study/${study.slug}`;
const shareTitle = `${study.title} | Ascend Consulting Case Study`;

const ArrowRightSm = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
const ExternalLink = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>`;
const ArrowLeft = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>`;
const CheckIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>`;
const Link2Icon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" x2="16" y1="12" y2="12"></line></svg>`;
const LinkedinIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>`;
const TwitterIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>`;
const FacebookIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`;
---

<Layout title={`${study.title} | Ascend Consulting Case Study`} description={`${study.tagline} — A case study by Ascend Consulting, founded by Brad Stave.`} bare canonical={pageUrl}>
	<div class="min-h-screen bg-white">
		<header id="cs-header" class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 shadow-sm backdrop-blur-sm">
			<div class="container mx-auto flex items-center justify-between gap-6 px-6 py-3 md:px-12">
				<div class="flex items-center gap-4">
					<a href="/" class="flex shrink-0 items-center gap-2">
						<img src="/images/ascend-logo-color.webp" alt="Ascend Consulting" class="h-8" />
					</a>
					<span class="hidden text-lg text-gray-300 sm:block">/</span>
					<span class="hidden max-w-xs truncate text-sm font-semibold text-primary sm:block">{study.client}</span>
				</div>
				<div class="flex items-center gap-3">
					<a href="/resources#case-studies" class="hidden items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-primary sm:inline-flex" set:html={`${ArrowLeft} Back to Resources`} />
					<a
						href={site.booking}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 rounded-sm bg-accent px-4 py-2 text-sm font-medium text-white transition-all hover:bg-accent/90"
						set:html={`Consultation ${ArrowRightSm}`}
					/>
				</div>
			</div>
		</header>

		<!-- Hero -->
		<section class="relative">
			<div class="relative h-[50vh] min-h-[400px] overflow-hidden">
				<img src={heroImage} alt={study.title} class={`h-full w-full object-cover ${study.heroObjectPosition ?? "object-center"}`} />
				<div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/60 to-transparent"></div>
				<div class="absolute inset-0 flex items-end">
					<div class="container mx-auto px-6 pb-12 md:px-12">
						<p class="mb-3 text-sm font-semibold tracking-widest text-accent uppercase">Case Study</p>
						<div class="mb-4 flex flex-wrap gap-2">
							{study.tags.map((tag) => (
								<span class="rounded-full border border-white/30 bg-white/20 px-3 py-1 text-xs text-white">{tag}</span>
							))}
						</div>
						<h1 class="max-w-4xl text-3xl leading-tight font-bold text-white md:text-5xl">{study.client} — {study.title}</h1>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats bar -->
		<section class="bg-primary">
			<div class="container mx-auto px-6 py-10 md:px-12">
				<div class="grid grid-cols-2 gap-8 md:grid-cols-4">
					{study.stats.map((s) => (
						<div class="text-center">
							<div class="mb-1 text-3xl font-bold text-accent md:text-4xl">{s.value}</div>
							<div class="text-sm text-white/70">{s.label}</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Main content -->
		<section class="py-20">
			<div class="container mx-auto max-w-4xl px-6 md:px-12">
				<p class="mb-16 border-l-4 border-accent pl-6 text-xl leading-relaxed font-medium text-gray-700 md:text-2xl">
					{study.tagline}
				</p>

				<div class="mb-14">
					<h2 class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">Organization</h2>
					<p class="text-lg leading-relaxed text-gray-700">{study.organization}</p>
				</div>

				<div class="mb-14">
					<h2 class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">The Challenge</h2>
					<p class="mb-6 text-lg leading-relaxed text-gray-700">{study.challenge}</p>
					{study.challengePoints && study.challengePoints.length > 0 && (
						<ul class="space-y-3">
							{study.challengePoints.map((point) => (
								<li class="flex items-start gap-3 text-gray-700">
									<span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
									{point}
								</li>
							))}
						</ul>
					)}
				</div>

				<div class="mb-14 rounded-sm border border-gray-100 bg-gray-50 p-8">
					<h2 class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">The Approach</h2>
					<p class="mb-6 text-lg leading-relaxed text-gray-700">{study.approach}</p>
					{study.approachPoints && study.approachPoints.length > 0 && (
						<ul class="space-y-3">
							{study.approachPoints.map((point, i) => (
								<li class="flex items-start gap-3 text-gray-700">
									<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">
										{i + 1}
									</span>
									{point}
								</li>
							))}
						</ul>
					)}
				</div>

				<div class="mb-16">
					<h2 class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">The Results</h2>
					<p class="text-lg leading-relaxed text-gray-700">{study.results}</p>
					{study.resultsExtra && <p class="mt-6 text-lg leading-relaxed text-gray-700">{study.resultsExtra}</p>}
				</div>

				{galleryImages.length > 0 && (
					<div class="mb-16">
						<h2 class="mb-6 text-xs font-bold tracking-widest text-accent uppercase">The Work</h2>
						<div class="grid gap-4 md:grid-cols-3">
							{galleryImages.map((img) => (
								<div class="group overflow-hidden rounded-sm border border-gray-100 shadow-sm">
									<div class="aspect-video overflow-hidden bg-gray-100">
										<img src={img.src} alt={img.alt} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" loading="lazy" />
									</div>
									{img.caption && <p class="border-t border-gray-100 px-4 py-3 text-xs leading-relaxed text-gray-500">{img.caption}</p>}
								</div>
							))}
						</div>
					</div>
				)}

				{study.paidAcquisitionSection && (
					<div class="mb-16">
						<div class="rounded-sm border border-gray-100 bg-gray-50 p-8 md:p-10">
							<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">Beyond the Brand</p>
							<h2 class="mb-4 text-2xl leading-snug font-bold text-primary md:text-3xl">{study.paidAcquisitionSection.headline}</h2>
							<p class="mb-8 max-w-3xl leading-relaxed text-gray-600">{study.paidAcquisitionSection.body}</p>
							<div class="grid gap-4 sm:grid-cols-2">
								{study.paidAcquisitionSection.pages.map((page) => (
									<a href={page.url} target="_blank" rel="noopener noreferrer" class="group flex flex-col rounded-sm border border-gray-200 bg-white p-6 transition-all hover:border-accent/40 hover:shadow-md">
										<div class="mb-3 flex items-start justify-between gap-3">
											<span class="rounded-full bg-accent/8 px-2.5 py-1 text-xs font-bold tracking-widest text-accent uppercase">{page.tag}</span>
											<span class="mt-0.5 shrink-0 text-gray-300 transition-colors group-hover:text-accent" set:html={ExternalLink} />
										</div>
										<h3 class="mb-2 text-base font-bold text-primary transition-colors group-hover:text-accent">{page.name}</h3>
										<p class="flex-1 text-sm leading-relaxed text-gray-500">{page.description}</p>
										<p class="mt-3 truncate text-xs text-gray-300">{page.url.replace("https://", "")}</p>
									</a>
								))}
							</div>
						</div>
					</div>
				)}

				{videoSection && (
					<div class="-mx-6 mb-16 md:-mx-12">
						<section class="border-t border-white/5 bg-[#0A1628] py-14">
							<div class="container mx-auto max-w-5xl px-6 md:px-12">
								<div class="grid items-center gap-10 md:grid-cols-2">
									<div>
										<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">{videoSection.label}</p>
										<h2 class="mb-4 text-2xl leading-snug text-white md:text-3xl" style="font-family: var(--font-serif);">{videoSection.headline}</h2>
										<p class="text-sm leading-relaxed text-white/55">{videoSection.body}</p>
									</div>
									<div class="relative aspect-video overflow-hidden rounded-lg border border-white/10 bg-black shadow-2xl">
										<video id="cs-video" src={videoSection.videoSrc} poster={videoSection.posterSrc} class="absolute inset-0 h-full w-full object-cover" playsinline preload="metadata"></video>
										<div id="cs-play-overlay" class="absolute inset-0 flex flex-col items-center justify-center transition-opacity duration-300" style="background: rgba(10,22,40,0.65);">
											<button type="button" id="cs-play-btn" aria-label="Play video" class="group flex flex-col items-center gap-2 focus:outline-none">
												<span class="flex h-14 w-14 items-center justify-center rounded-full bg-accent shadow-xl transition-all group-hover:scale-105 group-hover:bg-accent/80">
													<svg viewBox="0 0 24 24" class="h-6 w-6 fill-white" style="margin-left: 3px;"><polygon points="5,3 19,12 5,21"></polygon></svg>
												</span>
												{videoSection.watchLabel && <span class="text-xs font-semibold tracking-wide text-white/80 transition-colors group-hover:text-white">{videoSection.watchLabel}</span>}
											</button>
										</div>
									</div>
								</div>
								{videoSection.siteLink && (
									<div class="mt-10 flex flex-col gap-5 border-t border-white/10 pt-8 sm:flex-row sm:items-center">
										<p class="flex-1 text-sm leading-relaxed text-white/55">{videoSection.siteLink.description}</p>
										<a
											href={videoSection.siteLink.url}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex shrink-0 items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-medium text-white shadow-md transition-all hover:-translate-y-0.5 hover:bg-accent/80"
											set:html={`${videoSection.siteLink.label} ${ExternalLink}`}
										/>
									</div>
								)}
							</div>
						</section>
					</div>
				)}

				{study.detailedStats && study.detailedStats.length > 0 && (
					<div class="mb-16">
						<div class="overflow-hidden rounded-sm bg-primary">
							{study.detailedStatsHeadline && (
								<div class="px-8 pt-8 pb-4 text-center">
									<p class="mb-1 text-xs font-bold tracking-widest text-accent uppercase">By the Numbers</p>
									<h3 class="text-xl font-bold text-white md:text-2xl">{study.detailedStatsHeadline}</h3>
								</div>
							)}
							<div class="mx-8 mt-6 mb-8 grid grid-cols-2 gap-px overflow-hidden rounded-sm bg-white/10 md:grid-cols-4">
								{study.detailedStats.map((s) => (
									<div class="bg-primary/90 p-6 text-center">
										<div class="mb-2 text-3xl font-bold text-accent md:text-4xl">{s.value}</div>
										<div class="text-sm leading-snug text-white/70">{s.label}</div>
									</div>
								))}
							</div>
							{study.detailedStatsFootnote && (
								<div class="px-8 pb-8 text-center">
									<p class="text-sm text-white/60 italic">{study.detailedStatsFootnote}</p>
								</div>
							)}
						</div>
					</div>
				)}

				<!-- Share this case study -->
				<div class="mb-16 flex flex-col items-center gap-4 border-t border-gray-100 py-10">
					<p class="text-xs font-bold tracking-widest text-gray-400 uppercase">Share this case study</p>
					<div class="flex flex-wrap justify-center gap-3">
						<a
							href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Share on LinkedIn"
							class="flex items-center gap-2 rounded-full border border-gray-200 px-5 py-2.5 text-sm font-medium text-gray-500 transition-all duration-200 hover:border-[#0077B5] hover:bg-[#0077B5] hover:text-white"
							set:html={`${LinkedinIcon} LinkedIn`}
						/>
						<a
							href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareTitle)}`}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Share on X / Twitter"
							class="flex items-center gap-2 rounded-full border border-gray-200 px-5 py-2.5 text-sm font-medium text-gray-500 transition-all duration-200 hover:border-black hover:bg-black hover:text-white"
							set:html={`${TwitterIcon} X / Twitter`}
						/>
						<a
							href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Share on Facebook"
							class="flex items-center gap-2 rounded-full border border-gray-200 px-5 py-2.5 text-sm font-medium text-gray-500 transition-all duration-200 hover:border-[#1877F2] hover:bg-[#1877F2] hover:text-white"
							set:html={`${FacebookIcon} Facebook`}
						/>
						<button
							type="button"
							id="cs-copy-link"
							data-url={pageUrl}
							aria-label="Copy link to clipboard"
							class="flex items-center gap-2 rounded-full border border-gray-200 px-5 py-2.5 text-sm font-medium text-gray-500 transition-all duration-200 hover:border-primary hover:bg-primary hover:text-white"
						>
							<span id="cs-copy-icon" set:html={Link2Icon} />
							<span id="cs-copy-label">Copy Link</span>
						</button>
					</div>
				</div>

				<!-- Closing CTA -->
				<div class="rounded-sm bg-primary p-10 text-center">
					<h3 class="mb-3 text-2xl font-bold text-white">Ready to write your own success story?</h3>
					<p class="mx-auto mb-6 max-w-md text-white/70">Let's talk about how Ascend Consulting can help your organization achieve its next level of growth.</p>
					<a
						href={site.booking}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-sm bg-accent px-8 py-4 font-medium text-white transition-all hover:-translate-y-1 hover:bg-accent/90"
						set:html={`Schedule a Consultation ${ExternalLink}`}
					/>
				</div>
			</div>
		</section>

		<!-- More Case Studies -->
		<section class="border-t border-gray-100 bg-gray-50 py-16">
			<div class="container mx-auto px-6 md:px-12">
				<h3 class="mb-8 text-center text-sm font-bold tracking-widest text-primary uppercase">More Case Studies</h3>
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{otherStudies.map((cs) => (
						<a href={`/case-study/${cs.slug}`} class="group block overflow-hidden rounded-sm border border-gray-200 bg-white transition-all hover:-translate-y-1 hover:shadow-md">
							<div class="h-40 overflow-hidden">
								<img src={toImagePath(cs.heroImage)} alt={cs.title} class={`h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 ${cs.heroObjectPosition ?? "object-center"}`} loading="lazy" />
							</div>
							<div class="p-5">
								<p class="mb-1 text-xs font-semibold tracking-wider text-accent uppercase">{cs.client}</p>
								<h4 class="text-sm leading-snug font-bold text-primary transition-colors group-hover:text-accent">{cs.title}</h4>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<footer class="border-t border-gray-800 bg-gray-900 py-10 text-gray-400">
			<div class="container mx-auto flex flex-col items-center justify-between gap-4 px-6 md:flex-row md:px-12">
				<a href="/"><img src="/images/ascend-logo-white.webp" alt="Ascend Consulting" class="h-8 opacity-80" loading="lazy" /></a>
				<p class="text-sm">&copy; {new Date().getFullYear()} Ascend Consulting. All rights reserved.</p>
				<a href="/resources#case-studies" class="text-sm text-gray-500 transition-colors hover:text-white">&larr; Back to Case Studies</a>
			</div>
		</footer>
	</div>

	<script>
		const video = document.getElementById("cs-video") as HTMLVideoElement | null;
		const overlay = document.getElementById("cs-play-overlay");
		const playBtn = document.getElementById("cs-play-btn");
		function hideOverlay() {
			overlay?.classList.add("opacity-0", "pointer-events-none");
		}
		function showOverlay() {
			overlay?.classList.remove("opacity-0", "pointer-events-none");
		}
		playBtn?.addEventListener("click", () => {
			video?.play();
			video?.setAttribute("controls", "true");
			hideOverlay();
		});
		video?.addEventListener("pause", showOverlay);
		video?.addEventListener("ended", showOverlay);

		const copyBtn = document.getElementById("cs-copy-link");
		const copyIcon = document.getElementById("cs-copy-icon");
		const copyLabel = document.getElementById("cs-copy-label");
		const checkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>`;
		const linkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" x2="16" y1="12" y2="12"></line></svg>`;
		copyBtn?.addEventListener("click", () => {
			const url = copyBtn.getAttribute("data-url") || window.location.href;
			navigator.clipboard.writeText(url).then(() => {
				if (copyIcon) copyIcon.innerHTML = checkSvg;
				if (copyLabel) copyLabel.textContent = "Copied!";
				setTimeout(() => {
					if (copyIcon) copyIcon.innerHTML = linkSvg;
					if (copyLabel) copyLabel.textContent = "Copy Link";
				}, 2500);
			});
		});
	</script>
</Layout>
