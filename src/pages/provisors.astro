<script>
	const video = document.getElementById("ashdon-video") as HTMLVideoElement | null;
	const overlay = document.getElementById("ashdon-video-overlay");
	const playBtn = document.getElementById("ashdon-video-play");

	playBtn?.addEventListener("click", () => {
		video?.play();
		if (overlay) {
			overlay.style.opacity = "0";
			overlay.style.pointerEvents = "none";
		}
		if (video) video.controls = true;
	});
	video?.addEventListener("pause", () => {
		if (overlay) {
			overlay.style.opacity = "1";
			overlay.style.pointerEvents = "auto";
		}
	});
	video?.addEventListener("ended", () => {
		if (overlay) {
			overlay.style.opacity = "1";
			overlay.style.pointerEvents = "auto";
		}
	});
</script>
