					<a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 rounded-sm border border-white/25 px-7 py-3.5 font-semibold text-white/70 transition-colors hover:border-white/50 hover:text-white" set:html={`${Mail} ${site.email}`} />
