const Globe = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`;
const ArrowLeft = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>`;

interface ValuePoint {
	title: string;
	desc: string;
}

interface Partner {
	name: string;
	title: string;
	org: string;
	photo: string;
	photoPosition?: string;
	phone: string;
	email: string;
	website: string;
	websiteLabel: string;
	bio: string;
	valuePoints: ValuePoint[];
	orgPreview: string;
}

