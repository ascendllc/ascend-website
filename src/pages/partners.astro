function slugify(name: string) {
	return name
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");
}

function firstName(name: string) {
	return name.split(" ").find((part) => !["Dr.", "Mr.", "Ms.", "Mrs."].includes(part));
}
---

<Layout
	title="Trusted Partners | Ascend Consulting"
	description="Meet the trusted partner network of Ascend Consulting — specialists in leadership development, cybersecurity, creative production, commercial printing, revenue growth, and fractional sales leadership."
	bare
	canonical="https://ascendsmartly.com/partners"
>
	<div class="min-h-screen bg-white">
		<header id="partners-header" class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 shadow-sm backdrop-blur-sm">
			<div class="container mx-auto flex items-center justify-between gap-6 px-6 py-3 md:px-12">
				<div class="flex items-center gap-4">
					<a href="/" class="flex shrink-0 items-center gap-2">
						<img src="/images/ascend-logo-color.webp" alt="Ascend Consulting" class="h-8" />
					</a>
					<span class="hidden text-lg text-gray-300 sm:block">/</span>
					<a href="/resources" class="hidden text-sm font-medium text-gray-500 transition-colors hover:text-primary sm:block">Resources</a>
					<span class="hidden text-lg text-gray-300 sm:block">/</span>
					<span class="hidden text-sm font-semibold text-primary sm:block">Partners</span>
				</div>
				<div class="flex items-center gap-3">
					<a href="/resources" class="hidden items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-primary sm:inline-flex" set:html={`${ArrowLeft} Back to Resources`} />
					<a
						href={site.booking}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 rounded-sm bg-accent px-4 py-2 text-sm font-medium text-white transition-all hover:bg-accent/90"
						set:html={`Consultation ${ArrowRightSm}`}
					/>
				</div>
			</div>
		</header>

		<!-- Hero -->
		<section class="relative overflow-hidden bg-primary">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute top-0 right-0 h-[500px] w-[500px] rounded-full bg-accent/10 blur-[120px]"></div>
				<div class="absolute bottom-0 left-0 h-[400px] w-[400px] rounded-full bg-white/5 blur-[100px]"></div>
			</div>
			<div class="container relative z-10 mx-auto px-6 py-20 md:px-12">
				<div class="max-w-3xl">
					<p class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">Trusted Partners</p>
					<h1 class="mb-6 text-4xl leading-tight text-white md:text-5xl lg:text-6xl" style="font-family: var(--font-serif);">
						Extended Expertise,<br /><span class="text-accent">Built for Your Growth</span>
					</h1>
					<p class="text-lg leading-relaxed text-white/80 md:text-xl">
						Ascend Consulting is built on the belief that organizations grow strongest when clarity, capability, and trusted relationships work together. We collaborate with a select group of partners whose expertise naturally complements our strategic work — each bringing a distinct discipline that strengthens the systems, communication, and execution needed to help organizations rise.
					</p>
				</div>
			</div>
			<div class="h-2 w-full bg-accent"></div>
		</section>

		<!-- Partner Profiles -->
		<section class="py-16 md:py-20">
			<div class="container mx-auto px-6 md:px-12">
				<div class="space-y-12">
					{
						partners.map((p) => (
							<div id={slugify(p.name)} class="scroll-mt-[88px] overflow-hidden rounded-sm border border-gray-100 bg-white shadow-lg">
								<div class="flex flex-col md:flex-row">
									<div class="flex-shrink-0 md:w-64 lg:w-72">
										<img
											src={p.photo}
											alt={p.name}
											class="h-80 w-full object-cover md:h-full"
											style={`object-position:${p.photoPosition ?? "center 15%"}`}
											loading="lazy"
										/>
									</div>
									<div class="flex-1 p-8 md:p-10">
										<div class="mb-6">
											<p class="mb-2 text-xs font-bold tracking-widest text-accent uppercase">Trusted Partner</p>
											<h2 class="mb-1 text-2xl font-bold text-primary md:text-3xl">{p.name}</h2>
											<p class="mb-1 font-medium text-gray-500">{p.title}</p>
											<p class="text-lg font-semibold text-primary">{p.org}</p>
										</div>
										<div class="mb-6 flex flex-wrap gap-4 text-sm text-gray-600">
											<a href={`tel:${p.phone}`} class="flex items-center gap-1.5 transition-colors hover:text-primary" set:html={`${Phone} ${p.phone}`} />
											<a href={`mailto:${p.email}`} class="flex items-center gap-1.5 transition-colors hover:text-primary" set:html={`${Mail} ${p.email}`} />
											<a href={p.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 transition-colors hover:text-primary" set:html={`${Globe} ${p.websiteLabel}`} />
										</div>
										<div class="space-y-3">
											{p.bio.split("\n\n").map((para) => (
												<p class="leading-relaxed text-gray-600">{para}</p>
											))}
										</div>
									</div>
								</div>
								<div class="grid divide-y divide-gray-100 border-t border-gray-100 md:grid-cols-2 md:divide-x md:divide-y-0">
									<div class="p-8 md:p-10">
										<h3 class="mb-6 text-sm font-bold tracking-widest text-primary uppercase">How {firstName(p.name)} Adds Value</h3>
										<div class="space-y-5">
											{p.valuePoints.map((vp, i) => (
												<div class="flex gap-3">
													<div class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-accent text-xs font-bold text-white">{i + 1}</div>
													<div>
														<p class="mb-1 font-semibold text-primary">{vp.title}</p>
														<p class="text-sm leading-relaxed text-gray-600">{vp.desc}</p>
													</div>
												</div>
											))}
										</div>
									</div>
									<div class="bg-gray-50 p-8 md:p-10">
										<h3 class="mb-4 text-sm font-bold tracking-widest text-primary uppercase">About {p.org}</h3>
										<p class="mb-6 text-sm leading-relaxed text-gray-600">{p.orgPreview}</p>
										<a
											href={p.website}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-2 rounded-sm bg-primary px-5 py-2.5 text-sm font-medium text-white transition-all hover:-translate-y-0.5 hover:bg-primary/90"
											set:html={`Visit ${p.org} &rarr;`}
										/>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="relative overflow-hidden bg-primary py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute top-0 right-0 h-96 w-96 rounded-full bg-accent/10 blur-[100px]"></div>
			</div>
			<div class="container relative z-10 mx-auto px-6 text-center md:px-12">
				<h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Ready to connect with the right partner?</h2>
				<p class="mx-auto mb-8 max-w-xl text-lg text-white/75">Reach out to Ascend and we'll help match you with the right expert for your specific needs.</p>
				<a
					href={site.booking}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-sm bg-accent px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-accent/90"
					set:html={`Schedule a Consultation &rarr;`}
				/>
			</div>
		</section>

		<footer class="border-t border-gray-800 bg-gray-900 py-8">
			<div class="container mx-auto flex flex-col items-center justify-between gap-4 px-6 md:flex-row md:px-12">
				<a href="/" aria-label="Ascend Consulting — Back to home">
					<img src="/images/ascend-logo-white.webp" alt="" class="h-8" loading="lazy" />
				</a>
				<p class="text-sm text-gray-500">&copy; {new Date().getFullYear()} Ascend Consulting. All rights reserved.</p>
				<a href="/" class="text-sm text-gray-500 transition-colors hover:text-white">&larr; Back to Home</a>
			</div>
		</footer>
	</div>
</Layout>
