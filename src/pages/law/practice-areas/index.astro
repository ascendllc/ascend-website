---
import LawLayout from "../../../components/law/LawLayout.astro";
import { lawPracticeAreas } from "../../../data/law/practiceAreas";

const iconMap: Record<string, string> = {
	Briefcase: `<rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>`,
	ScaleHeart: `<path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path>`,
	Users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>`,
	Building: `<rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M16 14h.01"></path><path d="M8 10h.01"></path><path d="M8 14h.01"></path>`,
	Gavel: `<path d="m14.5 12.5-8 8a2.119 2.119 0 1 1-3-3l8-8"></path><path d="m16 16 6-6"></path><path d="m8 8 6-6"></path><path d="m9 7 8 8"></path><path d="m21 11-8-8"></path>`,
};
const ChevronRight = `<path d="m9 18 6-6-6-6"></path>`;
---

<LawLayout
	title="Practice Areas | Business, Estate Planning, Employment & Real Estate Law"
	description="Washington Law's eight attorneys specialize in Business & Corporate Law, Estate Planning & Trusts, Employment Law, Civil Litigation, and Real Estate Law across Seattle and the greater Puget Sound."
>
	<div class="min-h-screen bg-secondary/30 pt-32 pb-24">
		<div class="container mx-auto max-w-7xl px-6">
			<div class="mx-auto mb-20 max-w-3xl text-center">
				<p class="mb-4 font-sans text-sm font-bold tracking-widest text-accent uppercase">Our Expertise</p>
				<h1 class="font-display mb-6 text-5xl font-semibold text-primary lg:text-6xl">Practice Areas</h1>
				<p class="font-serif text-xl text-[#2e2e2e]">Deep specialization in the areas that matter most to Seattle's businesses and families.</p>
			</div>

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
				{lawPracticeAreas.map((p) => (
					<a href={`/law/practice-areas/${p.slug}`}>
						<div class="group flex h-full flex-col border border-gray-200 border-t-4 border-t-transparent bg-white p-10 transition-all duration-300 hover:border-t-accent hover:shadow-xl">
							<div class="mb-8 flex items-start justify-between">
								<div class="rounded-full bg-gray-50 p-4 text-primary transition-colors group-hover:text-accent">
									<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[p.icon] ?? ""} />
								</div>
								<span class="h-6 w-6 text-gray-300 transition-all group-hover:translate-x-1 group-hover:text-accent">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ChevronRight} />
								</span>
							</div>
							<h2 class="font-display mb-4 text-3xl font-semibold text-primary transition-colors group-hover:text-accent">{p.title}</h2>
							<p class="mb-8 flex-1 font-serif text-lg text-[#2e2e2e]">{p.shortDescription}</p>
							<div class="mt-auto border-t border-gray-100 pt-6">
								<p class="mb-3 font-sans text-xs font-bold tracking-widest text-gray-400 uppercase">Key Services</p>
								<ul class="space-y-2">
									{p.services.slice(0, 3).map((s) => (
										<li class="flex items-center gap-2 font-serif text-sm text-[#2e2e2e]">
											<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
											{s.split("(")[0].trim()}
										</li>
									))}
									{p.services.length > 3 && (
										<li class="mt-2 font-serif text-sm text-gray-500 italic">+ {p.services.length - 3} more services</li>
									)}
								</ul>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</div>
</LawLayout>
