---
import LawLayout from "../../../components/law/LawLayout.astro";
import { lawTeam } from "../../../data/law/team";

const ArrowRight = `<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>`;

const splitName = (full: string) => {
	const idx = full.indexOf(",");
	return idx === -1 ? { display: full, credentials: "" } : { display: full.slice(0, idx), credentials: full.slice(idx + 1).trim() };
};

const partners = lawTeam.filter((a) => a.title.includes("Partner"));
const associates = lawTeam.filter((a) => !a.title.includes("Partner"));
---

<LawLayout title="Our Attorneys | Seattle Law Firm | Washington Law" description="Meet Washington Law's eight Seattle attorneys: Meg Harrington (Business), James Ortega (Real Estate), Serena Voss (Estate Planning), Nathan Pierce (Civil Litigation), and four dedicated associates.">
	<!-- Hero -->
	<section class="relative overflow-hidden bg-primary pt-40 pb-24 md:pt-48 md:pb-28">
		<div class="absolute inset-0 z-0">
			<img src="/images/law/hero-seattle.png" alt="Seattle Skyline" class="h-full w-full object-cover opacity-40" />
			<div class="absolute inset-0 bg-primary/60 mix-blend-multiply"></div>
			<div class="absolute inset-0 bg-gradient-to-t from-primary via-transparent to-transparent"></div>
		</div>
		<div class="relative z-10 container mx-auto max-w-4xl px-6 text-center">
			<p class="mb-4 font-sans text-xs font-bold tracking-widest text-accent uppercase lg:text-sm">Our People</p>
			<h1 class="font-display mb-6 text-5xl leading-[1.1] font-semibold text-white italic md:text-6xl lg:text-7xl">Meet the Team</h1>
			<p class="mx-auto max-w-2xl font-serif text-xl leading-relaxed text-[#c7cede] lg:text-2xl">We are not the biggest firm in Seattle. We are exactly the right size to know you, fight for you, and win.</p>
		</div>
	</section>

	<!-- Team grids -->
	<section class="bg-white py-24">
		<div class="container mx-auto max-w-7xl px-6">
			<div class="mb-16 flex items-center gap-4">
				<h2 class="font-sans text-sm font-bold tracking-widest text-primary uppercase">Partners</h2>
				<div class="h-px flex-1 bg-border"></div>
			</div>
			<div class="mb-24 grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-4">
				{
					partners.map((a) => {
						const { display, credentials } = splitName(a.name);
						return (
							<a href={`/law/team/${a.slug}`} class="group block text-left">
								<div class="relative mb-6 aspect-[4/5] overflow-hidden border border-border bg-muted">
									<img src={a.image} alt={a.name} class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
								</div>
								<h3 class="font-display mb-1 text-2xl font-semibold text-primary transition-colors group-hover:text-accent">{display}</h3>
								{credentials && <div class="mb-3 font-sans text-xs tracking-wider text-gray-500 uppercase">{credentials}</div>}
								<p class="mb-4 font-sans text-xs font-bold tracking-widest text-gray-500 uppercase">{a.title.split("—")[0].trim()}</p>
								<p class="mb-4 font-serif text-sm text-[#2e2e2e]">{a.practiceAreas.join(" · ")}</p>
								<div
									class="flex items-center gap-2 font-sans text-sm font-semibold tracking-widest text-primary uppercase transition-colors group-hover:text-accent"
								>
									View Full Profile
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="transition-transform group-hover:translate-x-1"
										set:html={ArrowRight}
									/>
								</div>
							</a>
						);
					})
				}
			</div>

			<div class="mb-16 flex items-center gap-4">
				<h2 class="font-sans text-sm font-bold tracking-widest text-primary uppercase">Associates</h2>
				<div class="h-px flex-1 bg-border"></div>
			</div>
			<div class="grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-4">
				{
					associates.map((a) => {
						const { display, credentials } = splitName(a.name);
						return (
							<a href={`/law/team/${a.slug}`} class="group block text-left">
								<div class="relative mb-6 aspect-[4/5] overflow-hidden border border-border bg-muted">
									<img src={a.image} alt={a.name} class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
								</div>
								<h3 class="font-display mb-1 text-2xl font-semibold text-primary transition-colors group-hover:text-accent">{display}</h3>
								{credentials && <div class="mb-3 font-sans text-xs tracking-wider text-gray-500 uppercase">{credentials}</div>}
								<p class="mb-4 font-sans text-xs font-bold tracking-widest text-gray-500 uppercase">{a.title.split("—")[0].trim()}</p>
								<p class="mb-4 font-serif text-sm text-[#2e2e2e]">{a.practiceAreas.join(" · ")}</p>
								<div
									class="flex items-center gap-2 font-sans text-sm font-semibold tracking-widest text-primary uppercase transition-colors group-hover:text-accent"
								>
									View Full Profile
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="transition-transform group-hover:translate-x-1"
										set:html={ArrowRight}
									/>
								</div>
							</a>
						);
					})
				}
			</div>
		</div>
	</section>

	<!-- Join CTA -->
	<section class="bg-gray-50 py-20">
		<div class="container mx-auto max-w-3xl px-6 text-center">
			<h2 class="font-display mb-4 text-3xl font-semibold text-primary">Join Washington Law</h2>
			<p class="mx-auto mb-8 max-w-2xl font-serif text-[#2e2e2e]">We are always looking for sharp, dedicated attorneys and legal professionals who share our commitment to client-centered practice.</p>
			<a href="/law/contact" class="inline-block rounded-none border border-primary px-8 py-3.5 font-sans text-sm font-semibold tracking-widest text-primary uppercase transition-all hover:bg-primary hover:text-white">Inquire About Opportunities</a>
		</div>
	</section>
</LawLayout>
