---
import LawLayout from "../../../components/law/LawLayout.astro";
import { lawInsights } from "../../../data/law/insights";
---

<LawLayout title="Legal Insights & Blog | Washington Law | Seattle Attorneys" description="Attorney-authored articles on Washington state business law, estate planning, employment law, real estate, and civil litigation. Practical legal guidance from Washington Law's eight attorneys.">
	<div class="min-h-screen bg-white pt-32 pb-24">
		<div class="container mx-auto max-w-7xl px-6">
			<div class="mb-20">
				<p class="mb-4 font-sans text-sm font-bold tracking-widest text-accent uppercase">Legal Insights</p>
				<h1 class="font-display mb-6 text-5xl font-semibold text-primary lg:text-6xl">Analysis & Perspectives</h1>
				<p class="max-w-3xl font-serif text-xl text-[#2e2e2e]">Practical guidance and legal analysis from our attorneys on the issues affecting Pacific Northwest businesses and families.</p>
			</div>
			<div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3">
				{lawInsights.map((i: any) => (
					<a href={`/law/insights/${i.slug}`} class="group flex h-full flex-col cursor-pointer">
						<div class="relative mb-6 aspect-[16/10] overflow-hidden bg-secondary">
							<img src={i.image} alt={i.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
						</div>
						<div class="mb-4 flex items-center gap-4">
							<span class="font-sans text-xs font-bold tracking-widest text-accent uppercase">{i.category}</span>
							<span class="h-1 w-1 rounded-full bg-gray-300"></span>
							<span class="font-sans text-xs text-gray-500 uppercase">{i.date}</span>
						</div>
						<h3 class="font-display mb-3 text-2xl font-semibold text-primary transition-colors group-hover:text-accent">{i.title}</h3>
						<p class="mb-6 flex-1 font-serif text-[#2e2e2e]">{i.excerpt}</p>
						<div class="mt-auto flex items-center gap-3 border-t border-gray-200 pt-4">
							<span class="font-sans text-xs font-semibold text-primary">By {i.author}</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</div>
</LawLayout>
