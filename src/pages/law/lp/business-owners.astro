---
import LawLandingLayout from "../../../components/law/LawLandingLayout.astro";
import { lawTeam } from "../../../data/law/team";

const attorney = lawTeam.find((a) => a.slug === "margaret-harrington")!;

const CheckIcon = `<path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path>`;

const handled = [
	"Business Formation & Structuring",
	"Contract Drafting & Review",
	"Shareholder & Partnership Agreements",
	"M&A, Acquisitions & Due Diligence",
	"IP Licensing & Protection",
	"Employment Law Compliance",
	"Business Succession Planning",
	"Commercial Dispute Resolution",
];
---

<LawLandingLayout title="Business Law Attorney Seattle | Washington Law" description="Seattle business owners trust Washington Law for entity formation, contracts, M&A, and dispute resolution. Eight dedicated attorneys. Free initial consultation available." canonical="/law/lp/business-owners">
	<div class="w-full">
		<section id="get-started" class="bg-primary px-6 pt-12 pb-24 text-white">
			<div class="container mx-auto max-w-7xl">
				<div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-white/10 pb-4 font-sans text-xs font-bold tracking-widest text-accent uppercase">
					<span>★★★★★ 4.9</span>
					<span class="hidden sm:inline">|</span>
					<span>200+ Reviews</span>
					<span class="hidden sm:inline">|</span>
					<span>15 Years</span>
					<span class="hidden sm:inline">|</span>
					<span>$50M+ Outcomes</span>
				</div>
				<div class="grid grid-cols-1 items-start gap-16 lg:grid-cols-2">
					<div>
						<h1 class="font-display mb-8 text-5xl leading-[1.1] font-semibold italic lg:text-7xl">Your Business Deserves Bulletproof Legal Counsel.</h1>
						<p class="font-body mb-10 text-xl leading-relaxed text-secondary/90">Washington Law has protected Pacific Northwest businesses for 15 years. Straightforward counsel. Real results. Direct attorney access from day one.</p>
						<div class="hidden border-l-2 border-accent py-2 pl-6 lg:block">
							<p class="font-sans text-lg font-bold tracking-wide uppercase">Call for immediate assistance:</p>
							<p class="font-display mt-2 text-4xl text-accent">(206) 555-1847</p>
						</div>
					</div>
					<div class="relative rounded-sm bg-white p-8 text-primary shadow-2xl">
						<div class="absolute -top-3 left-8 bg-accent px-4 py-1 font-sans text-xs font-bold tracking-widest text-white uppercase">Free Consultation</div>
						<form class="space-y-4">
							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
								<input type="text" placeholder="First Name" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
								<input type="text" placeholder="Last Name" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							</div>
							<input type="email" placeholder="Email Address" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							<input type="tel" placeholder="Phone Number" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							<textarea placeholder="Tell us about your legal need..." class="min-h-[100px] w-full rounded-none border border-border px-4 py-2.5 text-sm"></textarea>
							<button type="button" title="This form isn't wired up to send yet — call us directly instead." class="w-full rounded-none bg-accent py-6 font-sans text-sm font-bold tracking-widest text-white uppercase hover:bg-accent/90">Book My Free Consultation →</button>
							<p class="mt-2 text-center font-sans text-xs text-gray-500">🔒 Confidential. Attorney-client privilege begins at first contact.</p>
						</form>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-secondary px-6 py-20">
			<div class="container mx-auto max-w-4xl text-center">
				<h2 class="font-display mb-8 text-4xl font-semibold text-primary">The legal gaps most growing businesses don't know they have.</h2>
				<div class="font-body mx-auto max-w-3xl space-y-6 text-left text-xl text-[#2E2E2E]">
					<p>Contracts written on templates from the internet. Partnerships that were never formalized. Employment practices that violate Washington state law. IP that was never properly protected.</p>
					<p class="font-medium text-primary">We see these situations daily. And we fix them — before they become lawsuits, before they cost you a deal, before they threaten what you've worked so hard to build.</p>
				</div>
			</div>
		</section>

		<section class="bg-white px-6 py-20">
			<div class="container mx-auto max-w-5xl">
				<p class="mb-8 text-center font-sans text-sm font-bold tracking-widest text-accent uppercase">What we handle for PNW businesses:</p>
				<div class="grid grid-cols-1 gap-x-12 gap-y-6 md:grid-cols-2">
					{handled.map((h) => (
						<div class="flex items-center gap-4 border-b border-border pb-4">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 shrink-0 text-accent" set:html={CheckIcon} />
							<span class="font-body text-lg font-medium text-primary">{h}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-primary px-6 py-20 text-white">
			<div class="container mx-auto max-w-4xl text-center">
				<p class="font-display mb-8 text-3xl leading-relaxed italic lg:text-4xl">"Meg Harrington is the only attorney I trust with my company. She thinks like a business owner and talks like a human being. After four years, I've referred six other founders to her."</p>
				<p class="mb-1 font-sans font-bold tracking-widest text-accent uppercase">— Derek F., CEO, PNW Ventures</p>
				<p class="font-body text-secondary/70">Result: $3.2M shareholder settlement secured in 90 days.</p>
			</div>
		</section>

		<section class="bg-white px-6 py-24">
			<div class="container mx-auto max-w-5xl">
				<div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
					<div>
						<img src={attorney.image} alt={attorney.name} class="aspect-square w-full object-cover shadow-xl" />
					</div>
					<div>
						<h2 class="font-display mb-2 text-4xl font-semibold text-primary">Meet {attorney.name.split(",")[0]}.</h2>
						<p class="mb-6 font-sans text-sm font-bold tracking-widest text-accent uppercase">Founding Partner. 15 years. 500+ business clients.</p>
						<p class="font-body mb-8 border-l-4 border-accent pl-6 text-lg text-[#2E2E2E] italic">"The firms I competed with were billing my future clients for six-minute increments on emails they never read. I built Washington Law so that would never be someone's experience."</p>
						<a href="#get-started" class="inline-block rounded-none bg-primary px-8 py-6 font-sans text-sm font-bold tracking-widest text-white uppercase hover:bg-primary/90">Book a 30-minute consultation with Meg →</a>
					</div>
				</div>
			</div>
		</section>

		<section class="border-t-4 border-accent bg-secondary px-6 py-24 text-center">
			<h2 class="font-display mb-6 text-5xl font-semibold text-primary">Ready to talk? So are we.</h2>
			<p class="font-display mb-2 text-4xl text-accent">(206) 555-1847</p>
			<p class="font-body mb-8 text-xl text-[#2E2E2E]">hello@washingtonlaw.com<br />1420 Fifth Avenue, Suite 1800, Seattle, WA</p>
			<a href="#get-started" class="inline-block w-full rounded-none bg-accent px-8 py-6 font-sans text-sm font-bold tracking-wide text-white uppercase shadow-xl transition-all hover:scale-105 hover:bg-accent/90 sm:w-auto sm:px-10 sm:py-8 sm:tracking-widest sm:text-lg">Book Your Free 30-Min Consult →</a>
		</section>

		<div class="fixed bottom-0 left-0 z-50 flex w-full gap-2 bg-primary p-4 lg:hidden">
			<a href="tel:2065551847" class="flex-1 rounded-none bg-white py-3 text-center font-sans font-bold tracking-widest text-primary uppercase hover:bg-secondary">Call Now</a>
			<a href="#get-started" class="flex-1 rounded-none bg-accent py-3 text-center font-sans font-bold tracking-widest text-white uppercase hover:bg-accent/90">Book Free</a>
		</div>
	</div>
</LawLandingLayout>
