---
import LawLandingLayout from "../../../components/law/LawLandingLayout.astro";
import { lawTeam } from "../../../data/law/team";

const attorney = lawTeam.find((a) => a.slug === "serena-voss")!;

const packageItems = [
	"Last Will & Testament",
	"Revocable Living Trust (when applicable)",
	"Healthcare Directive / Living Will",
	"Durable Power of Attorney (Financial)",
	"Power of Attorney (Healthcare)",
	"Beneficiary Review & Alignment",
	"Family Guidance Session",
];

const reasonOptions = [
	{ value: "basic", label: "I need a basic will and healthcare directive" },
	{ value: "trust", label: "I want to set up a trust" },
	{ value: "taxes", label: "I'm concerned about estate taxes" },
	{ value: "update", label: "I need to update an existing plan" },
	{ value: "unsure", label: "I'm not sure — I need guidance" },
];
---

<LawLandingLayout title="Estate Planning Attorney Seattle | Washington Law" description="Washington Law's estate planning attorneys help Seattle families protect their assets, honor their wishes, and spare loved ones from uncertainty. Wills, trusts, powers of attorney. Free consultation.">
	<div class="w-full">
		<section id="get-started" class="relative overflow-hidden bg-secondary px-6 py-20">
			<div class="absolute top-0 right-0 bottom-0 hidden w-1/2 opacity-40 lg:block">
				<img src="/images/law/practice-estate.png" alt="Family" class="h-full w-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-r from-secondary to-transparent"></div>
			</div>
			<div class="relative z-10 container mx-auto max-w-7xl">
				<div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
					<div>
						<h1 class="font-display mb-8 text-5xl leading-tight font-semibold text-primary lg:text-7xl">You've spent a lifetime building this. Let's make sure it's protected.</h1>
						<p class="font-body mb-10 text-xl leading-relaxed text-[#2E2E2E]">Estate planning is one of the most important decisions your family will benefit from — and one of the easiest to keep putting off. Washington Law makes it simple, personal, and surprisingly affordable.</p>
					</div>
					<div class="rounded-sm border border-border bg-white p-8 shadow-xl">
						<h3 class="font-display mb-6 text-3xl font-semibold text-primary">Start Your Estate Plan</h3>
						<form class="space-y-4">
							<input type="text" placeholder="Full Name" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							<input type="email" placeholder="Email" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							<input type="tel" placeholder="Phone" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							<select class="w-full rounded-none border border-border px-4 py-2.5 text-sm text-gray-500">
								<option value="">What brings you in today?</option>
								{reasonOptions.map((r) => <option value={r.value}>{r.label}</option>)}
							</select>
							<button type="button" title="This form isn't wired up to send yet — call us directly instead." class="mt-4 w-full rounded-none bg-[#7C5C3E] py-6 font-sans text-sm font-bold tracking-widest text-white uppercase hover:bg-[#7C5C3E]/90">Begin My Estate Plan →</button>
						</form>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-primary px-6 py-20 text-center text-white">
			<div class="container mx-auto max-w-4xl">
				<h2 class="font-display mb-12 text-4xl font-semibold lg:text-5xl">"Most families wait too long. Here's what we hear after."</h2>
				<div class="font-body mb-12 grid grid-cols-1 gap-8 text-left text-xl text-secondary/80 italic md:grid-cols-2">
					<p class="border-l-2 border-[#7C5C3E] pl-6">"I wish we had done this before the accident."</p>
					<p class="border-l-2 border-[#7C5C3E] pl-6">"We had no idea what accounts went where."</p>
					<p class="border-l-2 border-[#7C5C3E] pl-6">"The probate process took 18 months. It was devastating."</p>
					<p class="border-l-2 border-[#7C5C3E] pl-6">"She would have wanted the house to go to her daughter."</p>
				</div>
				<p class="font-sans text-lg font-bold tracking-wide text-accent uppercase">A complete estate plan takes 3-4 weeks. The alternative can take years.</p>
			</div>
		</section>

		<section class="bg-white px-6 py-24">
			<div class="container mx-auto max-w-5xl text-center">
				<h2 class="font-display mb-12 text-4xl font-semibold text-primary">The Washington Law Estate Planning Package Includes:</h2>
				<div class="mx-auto mb-16 grid max-w-3xl grid-cols-1 gap-x-8 gap-y-4 text-left md:grid-cols-2">
					{packageItems.map((item) => (
						<div class="flex items-center gap-3 border border-border bg-secondary p-4">
							<span class="font-display text-xl text-[#7C5C3E]">📄</span>
							<span class="font-body font-medium text-primary">{item}</span>
						</div>
					))}
				</div>
				<div class="grid grid-cols-1 items-center gap-8 border-t-4 border-[#7C5C3E] bg-secondary p-12 text-left md:grid-cols-4">
					<div class="md:col-span-1">
						<img src={attorney.image} alt={attorney.name} class="aspect-square w-full rounded-full object-cover shadow-lg" />
					</div>
					<div class="md:col-span-3">
						<p class="font-display mb-4 text-2xl text-primary italic">"I spent years studying how families navigate hard moments. Now I help them prepare for them."</p>
						<p class="font-sans text-sm font-bold tracking-widest text-[#7C5C3E] uppercase">Serena Voss, J.D., Ph.D. | Estate Planning Partner</p>
					</div>
				</div>
			</div>
		</section>

		<div class="fixed bottom-0 left-0 z-50 flex w-full gap-2 border-t border-border bg-white p-4 lg:hidden">
			<a href="tel:2065551847" class="flex-1 rounded-none bg-[#7C5C3E] py-3 text-center font-sans font-bold tracking-widest text-white uppercase hover:bg-[#7C5C3E]/90">Call Now: (206) 555-1847</a>
			<a href="#get-started" class="rounded-none border border-[#7C5C3E] px-4 py-3 text-center font-sans text-xs font-bold tracking-widest text-[#7C5C3E] uppercase">Free Consult</a>
		</div>
	</div>
</LawLandingLayout>
