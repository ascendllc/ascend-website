---
import LawLandingLayout from "../../../components/law/LawLandingLayout.astro";
import { lawTeam } from "../../../data/law/team";

const attorney = lawTeam.find((a) => a.slug === "amara-thompson")!;

const ScaleIcon = `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>`;
const ShieldCheckIcon = `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path>`;
const ClockIcon = `<path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle>`;
const LockIcon = `<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>`;

const situationOptions = [
	{ value: "fired_no_reason", label: "Fired without cause or explanation" },
	{ value: "retaliation", label: "Fired after reporting misconduct" },
	{ value: "discrimination", label: "Fired due to race, gender, age, or disability" },
	{ value: "harassment", label: "Experiencing harassment or hostile work environment" },
	{ value: "wages", label: "Unpaid wages, overtime, or commissions" },
	{ value: "severance", label: "Offered severance — not sure if I should sign" },
	{ value: "other", label: "Something else" },
];
const urgencyOptions = [
	{ value: "immediately", label: "Immediately — this is urgent" },
	{ value: "this_week", label: "This week" },
	{ value: "this_month", label: "Within the next month" },
	{ value: "exploring", label: "Just exploring my options" },
];

const highlights = [
	{ icon: ShieldCheckIcon, text: "No fee unless we win — zero financial risk to you" },
	{ icon: LockIcon, text: "Attorney-client privilege begins at your very first call" },
	{ icon: ClockIcon, text: "Washington has strict deadlines — don't wait to find out if you have a case" },
];

const results = [
	{ amount: "$890K", desc: "Wrongful termination — 11-year employee, retaliation claim" },
	{ amount: "$475K", desc: "Wage theft class action — 12 restaurant workers, back pay secured" },
	{ amount: "Reinstated", desc: "Discrimination claim resolved, client returned to work with full back pay" },
];
---

<LawLandingLayout title="Wrongfully Fired in Seattle? Free Case Review | Washington Law" description="Were you fired in Seattle after reporting workplace violations, discrimination, or without legal cause? Washington Law's employment attorneys offer a free 15-minute case review. No fee unless we win.">
	<div class="w-full">
		<div class="bg-[#2D6A4F] px-6 py-3 text-white">
			<div class="container mx-auto flex max-w-7xl flex-wrap justify-center gap-x-8 gap-y-1 font-sans text-xs font-bold tracking-widest uppercase">
				<span>★★★★★ 4.9 Rating</span>
				<span class="hidden sm:inline">|</span>
				<span>200+ Clients Represented</span>
				<span class="hidden sm:inline">|</span>
				<span>No Fee Unless We Win</span>
				<span class="hidden sm:inline">|</span>
				<span>Completely Confidential</span>
			</div>
		</div>

		<section id="get-started" class="bg-primary px-6 py-16 text-white lg:py-24">
			<div class="container mx-auto max-w-7xl">
				<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-16">
					<div>
						<div class="mb-8 inline-flex items-center gap-2 bg-[#2D6A4F] px-4 py-2 font-sans text-xs font-bold tracking-widest text-white uppercase">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" set:html={ScaleIcon} />
							Washington Employment Law
						</div>
						<h1 class="font-display mb-6 text-5xl leading-[1.1] font-semibold italic lg:text-7xl">Fired in Seattle? <span class="text-[#74C69D]">You May Have More Rights Than You Think.</span></h1>
						<p class="font-body mb-10 text-xl leading-relaxed text-secondary/90">Washington's at-will employment has limits. If your termination was based on discrimination, retaliation, or a contract violation — you may be entitled to significant compensation. Our last settlement: <strong class="text-[#74C69D]">$890,000</strong>.</p>
						<div class="mb-10 space-y-4">
							{highlights.map((h) => (
								<div class="flex items-start gap-4">
									<div class="mt-0.5 shrink-0 text-[#74C69D]">
										<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" set:html={h.icon} />
									</div>
									<p class="font-body text-lg text-secondary/90">{h.text}</p>
								</div>
							))}
						</div>
						<div class="flex items-center gap-4 border-t border-white/10 pt-8">
							<img src={attorney.image} alt={attorney.name} class="h-16 w-16 rounded-full border-2 border-[#2D6A4F] object-cover" />
							<div>
								<p class="font-sans font-bold text-white">Amara Thompson, J.D.</p>
								<p class="font-body text-sm text-secondary/70">Employment Law · Washington Law</p>
							</div>
						</div>
					</div>
					<div class="relative bg-white p-8 text-primary shadow-2xl">
						<div class="absolute -top-3 left-8 bg-[#2D6A4F] px-4 py-1 font-sans text-xs font-bold tracking-widest text-white uppercase">Free 15-Min Case Review</div>
						<form class="mt-4 space-y-4">
							<h3 class="font-display mb-2 text-2xl font-semibold text-primary">Tell us what happened.</h3>
							<input type="text" placeholder="Full Name" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
								<input type="email" placeholder="Email" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
								<input type="tel" placeholder="Phone" class="w-full rounded-none border border-border px-4 py-2.5 text-sm" />
							</div>
							<select class="w-full rounded-none border border-border px-4 py-2.5 text-sm text-gray-500">
								<option value="">What happened to you?</option>
								{situationOptions.map((s) => <option value={s.value}>{s.label}</option>)}
							</select>
							<select class="w-full rounded-none border border-border px-4 py-2.5 text-sm text-gray-500">
								<option value="">How soon do you need help?</option>
								{urgencyOptions.map((u) => <option value={u.value}>{u.label}</option>)}
							</select>
							<textarea placeholder="Brief description (optional — you can share more on your call)" class="min-h-[80px] w-full rounded-none border border-border px-4 py-2.5 text-sm"></textarea>
							<button type="button" title="This form isn't wired up to send yet — call us directly instead." class="w-full rounded-none bg-[#2D6A4F] py-6 font-sans text-sm font-bold tracking-widest text-white uppercase hover:bg-[#2D6A4F]/90">Get My Free Case Review →</button>
							<p class="text-center font-sans text-xs text-gray-500">🔒 Confidential. No fee unless we win.</p>
						</form>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-secondary px-6 py-16">
			<div class="container mx-auto max-w-5xl">
				<p class="mb-10 text-center font-sans text-sm font-bold tracking-widest text-[#2D6A4F] uppercase">Recent Employment Law Results</p>
				<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
					{results.map((r) => (
						<div class="border-t-4 border-[#2D6A4F] bg-white p-8 text-center shadow-sm">
							<p class="font-display mb-3 text-4xl font-semibold text-[#2D6A4F]">{r.amount}</p>
							<p class="font-body text-[#2E2E2E]">{r.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-[#2D6A4F] px-6 py-16 text-white">
			<div class="container mx-auto max-w-3xl text-center">
				<p class="font-display mb-6 text-3xl leading-relaxed italic lg:text-4xl">"They're often embarrassed. Scared. Convinced they did something wrong. They almost never did."</p>
				<p class="font-sans text-sm font-bold tracking-widest uppercase opacity-80">— Amara Thompson, J.D., Employment Law</p>
			</div>
		</section>

		<section class="border-t-4 border-[#2D6A4F] bg-white px-6 py-16">
			<div class="container mx-auto max-w-3xl">
				<div class="flex flex-col items-center gap-8 bg-secondary p-8 sm:flex-row">
					<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16 shrink-0 text-[#2D6A4F]" set:html={LockIcon} />
					<div>
						<h3 class="font-display mb-2 text-2xl font-semibold text-primary">Zero Financial Risk</h3>
						<p class="font-body text-[#2E2E2E]">Washington Law handles employment cases on contingency — we only get paid if you win. Your case review is completely free and confidential. There is no obligation to hire us after your consultation.</p>
					</div>
				</div>
				<div class="mt-8 text-center">
					<a href="#get-started" class="inline-block w-full rounded-none bg-[#2D6A4F] px-10 py-6 text-center font-sans text-sm font-bold tracking-wide text-white uppercase hover:bg-[#2D6A4F]/90 sm:w-auto sm:tracking-widest">Get My Free Case Review →</a>
				</div>
			</div>
		</section>

		<footer class="bg-primary px-6 py-6 text-center text-xs text-white/50">
			<p>© {new Date().getFullYear()} Washington Law PLLC · 1420 Fifth Avenue, Suite 1800, Seattle, WA 98101 · <a href="tel:12065551847" class="transition-colors hover:text-white">(206) 555-1847</a></p>
			<p class="mt-2">Attorney advertising. Past results do not guarantee future outcomes. This page does not constitute legal advice.</p>
		</footer>

		<div class="fixed bottom-0 left-0 z-50 flex w-full gap-2 border-t-2 border-[#2D6A4F] bg-white p-4 lg:hidden">
			<a href="tel:2065551847" class="flex-1 rounded-none bg-[#2D6A4F] py-3 text-center font-sans text-xs font-bold tracking-wider text-white uppercase hover:bg-[#2D6A4F]/90">Call Now: (206) 555-1847</a>
			<a href="#get-started" class="rounded-none border border-[#2D6A4F] px-4 py-3 text-center font-sans text-xs font-bold tracking-wider text-[#2D6A4F] uppercase">Free Review</a>
		</div>
	</div>
</LawLandingLayout>
