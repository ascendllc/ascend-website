---
import FinanceLayout from "../../../components/finance/FinanceLayout.astro";

const ArrowLeft = `<path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>`;
const ArrowRight = `<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>`;
const CalendarIcon = `<path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>`;

const calendar = [
	{
		month: "January",
		dates: [
			{ day: "15", type: "Federal", title: "Q4 Estimated Tax Payment Due", desc: "Final estimated tax payment for the previous tax year." },
			{ day: "31", type: "Federal", title: "W-2 and 1099-NEC Deadline", desc: "Deadline to issue forms to employees and independent contractors." },
			{ day: "31", type: "State", title: "WA State B&O Tax Due (Annual/Q4)", desc: "Annual and Q4 filers must submit Washington State Department of Revenue returns." },
		],
	},
	{
		month: "March",
		dates: [{ day: "15", type: "Federal", title: "S-Corp and Partnership Returns Due", desc: "Form 1120-S and Form 1065 due, or file for a 6-month extension." }],
	},
	{
		month: "April",
		dates: [
			{ day: "15", type: "Federal", title: "Individual Tax Returns Due", desc: "Form 1040 due or file for an automatic 6-month extension." },
			{ day: "15", type: "Federal", title: "C-Corp Returns Due", desc: "Form 1120 due for calendar-year C-Corporations." },
			{ day: "15", type: "Federal", title: "Q1 Estimated Tax Payment Due", desc: "First estimated tax payment for the current tax year." },
			{ day: "30", type: "State", title: "WA State B&O Tax Due (Q1)", desc: "Quarterly filers must submit Q1 Washington State returns." },
		],
	},
	{
		month: "June",
		dates: [{ day: "16", type: "Federal", title: "Q2 Estimated Tax Payment Due", desc: "Second estimated tax payment for the current tax year." }],
	},
	{
		month: "July",
		dates: [{ day: "31", type: "State", title: "WA State B&O Tax Due (Q2)", desc: "Quarterly filers must submit Q2 Washington State returns." }],
	},
	{
		month: "September",
		dates: [
			{ day: "15", type: "Federal", title: "Extended S-Corp & Partnership Returns Due", desc: "Final deadline for entities that filed extensions in March." },
			{ day: "15", type: "Federal", title: "Q3 Estimated Tax Payment Due", desc: "Third estimated tax payment for the current tax year." },
		],
	},
	{
		month: "October",
		dates: [
			{ day: "15", type: "Federal", title: "Extended Individual Returns Due", desc: "Final deadline for individuals who filed extensions in April." },
			{ day: "15", type: "Federal", title: "Extended C-Corp Returns Due", desc: "Final deadline for calendar-year C-Corporations that filed extensions." },
			{ day: "31", type: "State", title: "WA State B&O Tax Due (Q3)", desc: "Quarterly filers must submit Q3 Washington State returns." },
		],
	},
];
---

<FinanceLayout title="2025 Tax Deadline Calendar | Federal & WA State | WAFS" description="Complete 2025 federal and Washington State tax deadlines for businesses and individuals. Never miss a filing date with WAFS's interactive tax calendar.">
	<!-- Hero -->
	<section class="relative bg-wafs-forest pt-40 pb-24 text-warmwhite md:pt-48 md:pb-32">
		<div class="absolute inset-0 z-0">
			<img src="/images/finance/hero-seattle.png" alt="Seattle skyline" class="h-full w-full object-cover opacity-60" />
			<div class="absolute inset-0 bg-gradient-to-t from-wafs-forest via-wafs-forest/45 to-transparent"></div>
		</div>
		<div class="relative z-10 container mx-auto px-6">
			<div class="max-w-4xl">
				<a href="/finance/resources" class="mb-8 flex items-center gap-2 text-sm font-medium text-wafs-gold transition-colors hover:text-warmwhite">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 rotate-180" set:html={ArrowLeft} /> Back to Resources
				</a>
				<h1 class="font-display mb-8 text-5xl leading-tight font-semibold md:text-7xl">2025 Tax Calendar</h1>
				<p class="font-sans text-xl leading-relaxed text-warmwhite/80">Key federal deadlines and Washington State B&O tax due dates for business owners and high-net-worth individuals.</p>
			</div>
		</div>
	</section>

	<!-- Calendar -->
	<section class="bg-warmwhite py-24">
		<div class="container mx-auto px-6">
			<div class="mx-auto max-w-4xl space-y-16">
				<div class="mb-12 flex items-center justify-center gap-4 rounded-sm border border-[#d4e6dc] bg-[#f0ede8] p-4">
					<span class="flex items-center gap-2 text-sm font-semibold text-nearblack">
						<div class="h-3 w-3 rounded-full bg-wafs-slate"></div> Federal Deadline
					</span>
					<span class="flex items-center gap-2 text-sm font-semibold text-nearblack">
						<div class="h-3 w-3 rounded-full bg-wafs-evergreen"></div> WA State Deadline
					</span>
				</div>

				{calendar.map((m) => (
					<div>
						<h2 class="font-display mb-6 flex items-center gap-3 text-3xl font-semibold text-wafs-forest">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-wafs-gold" set:html={CalendarIcon} />
							{m.month}
						</h2>
						<div class="overflow-hidden rounded-sm border border-[#d4e6dc] bg-white shadow-sm">
							<div class="divide-y divide-[#d4e6dc]">
								{m.dates.map((d) => (
									<div class="grid grid-cols-1 p-6 transition-colors hover:bg-[#f0ede8]/50 md:grid-cols-12">
										<div class="mb-4 flex flex-col justify-center border-l-4 pl-4 md:col-span-3 md:mb-0" style={`border-color: ${d.type === "Federal" ? "#2c5282" : "#2d6a4f"}`}>
											<span class="font-display text-3xl leading-none font-semibold text-wafs-forest">{d.day}</span>
											<span class="mt-1 text-xs font-semibold tracking-widest text-nearblack uppercase">{d.type}</span>
										</div>
										<div class="flex flex-col justify-center md:col-span-9">
											<h3 class="mb-1 font-sans text-lg font-semibold text-nearblack">{d.title}</h3>
											<p class="text-sm text-[#4a5568]">{d.desc}</p>
										</div>
									</div>
								))}
							</div>
						</div>
					</div>
				))}

				<div class="mt-16 rounded-sm bg-wafs-forest p-8 text-center text-warmwhite">
					<h3 class="font-display mb-4 text-2xl font-semibold">Never Miss a Deadline</h3>
					<p class="mb-6 text-warmwhite/80">WAFS clients receive proactive reminders and strategic planning sessions well ahead of every major tax deadline.</p>
					<a href="/finance/contact" class="inline-flex items-center gap-2 rounded-md bg-wafs-gold px-8 py-4 font-semibold text-wafs-forest transition-colors hover:bg-wafs-gold/90">
						Become a Client <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ArrowRight} />
					</a>
				</div>
			</div>
		</div>
	</section>
</FinanceLayout>
