---
import FinanceLayout from "../../../components/finance/FinanceLayout.astro";

const ArrowRight = `<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>`;

const BlogIcon = `<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><path d="M10 6h8v4h-8V6Z"></path>`;
const CalcIcon = `<rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path>`;
const DownloadIcon = `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line>`;
const CalendarIcon = `<path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>`;

const cards = [
	{ title: "Blog", desc: "Latest insights from our partners on tax strategy, business advisory, and wealth planning.", cta: "Read Articles", href: "/finance/resources/blog", icon: BlogIcon },
	{ title: "Calculators", desc: "Interactive tools for tax savings, retirement projection, and CFO ROI.", cta: "Use Calculators", href: "/finance/resources/calculators", icon: CalcIcon },
	{ title: "Downloads", desc: "Free planning guides, checklists, and comparison frameworks.", cta: "View Downloads", href: "/finance/resources/downloads", icon: DownloadIcon },
	{ title: "Tax Calendar", desc: "Key federal and Washington State tax deadlines throughout the year.", cta: "View Calendar", href: "/finance/resources/tax-calendar", icon: CalendarIcon },
];
---

<FinanceLayout title="Financial Resources & Insights | WAFS Seattle" description="Tax guides, financial calculators, blog articles, and downloadable resources from the CPAs at Washington Accounting & Financial Services.">
	<!-- Hero -->
	<section class="relative bg-wafs-forest pt-32 pb-20 text-warmwhite">
		<div class="absolute inset-0 z-0">
			<img src="/images/finance/hero-seattle.png" alt="Seattle skyline" class="h-full w-full object-cover opacity-60" />
			<div class="absolute inset-0 bg-gradient-to-t from-wafs-forest via-wafs-forest/45 to-transparent"></div>
		</div>
		<div class="relative z-10 container mx-auto px-6">
			<div class="max-w-3xl">
				<h1 class="font-display mb-6 text-5xl font-semibold md:text-6xl">Resources & Insights</h1>
				<p class="text-lg text-warmwhite/80 md:text-xl">From tax calendars to financial calculators to in-depth articles, WAFS produces practical content to help Pacific Northwest business owners and families make better financial decisions.</p>
			</div>
		</div>
	</section>

	<!-- Cards -->
	<section class="bg-warmwhite py-20">
		<div class="container mx-auto px-6">
			<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
				{cards.map((c) => (
					<div class="rounded-sm border border-[#d4e6dc] bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-lg">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-wafs-forest/10 text-wafs-forest">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={c.icon} />
						</div>
						<h3 class="font-display mb-2 text-xl font-semibold text-wafs-forest">{c.title}</h3>
						<p class="mb-6 text-[#4a5568]">{c.desc}</p>
						<a href={c.href} class="group flex items-center gap-2 font-semibold text-wafs-evergreen">
							{c.cta} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" set:html={ArrowRight} />
						</a>
					</div>
				))}
			</div>
		</div>
	</section>
</FinanceLayout>
