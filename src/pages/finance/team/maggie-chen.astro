---
import FinanceLayout from "../../../components/finance/FinanceLayout.astro";

const ArrowLeft = `<path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path>`;
const Phone = `<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path>`;
const Mail = `<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>`;

const focusAreas = ["Corporate tax strategy", "M&A tax structuring", "Real estate taxation", "IRS representation", "Cross-border transactions", "Washington State B&O tax"];
const industries = [
	{ label: "Technology & Startups", href: "/finance/industries/technology-startups" },
	{ label: "Real Estate", href: "/finance/industries/real-estate" },
	{ label: "Professional Services", href: "/finance/industries/professional-services" },
];
const credentials = [
	"Certified Public Accountant (WA, 2003)",
	"Master of Taxation, UW Foster School of Business",
	"B.A. Accounting, University of Washington",
	"American Institute of CPAs (AICPA)",
	"Washington Society of CPAs (WSCPA)",
	"Board Member, Seattle Metropolitan Chamber",
];
---

<FinanceLayout title={`Maggie Chen, CPA/MT | Managing Partner | WAFS Seattle`} description={`Margaret "Maggie" Chen, CPA/MT is the Managing Partner of Washington Accounting & Financial Services, specializing in corporate tax strategy and M&A advisory for Pacific Northwest businesses.`}>
	<!-- Hero -->
	<section class="bg-wafs-forest text-warmwhite pt-32 pb-16">
		<div class="container mx-auto px-6">
			<a href="/finance/team" class="text-warmwhite/60 hover:text-wafs-gold text-sm font-medium flex items-center gap-2 mb-8 transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ArrowLeft} /> Back to Team
			</a>
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<div class="relative lg:col-span-5 aspect-[4/5] overflow-hidden rounded-sm border-4 border-wafs-evergreen">
					<img src="/images/finance/team-maggie.png" alt="Maggie Chen" class="absolute top-0 left-0 w-full h-[120%] object-cover object-top" />
				</div>
				<div class="lg:col-span-7">
					<div class="flex flex-wrap gap-2 mb-6">
						<span class="bg-wafs-gold text-wafs-forest text-xs font-mono px-3 py-1 rounded-full font-semibold">CPA</span>
						<span class="bg-wafs-evergreen text-warmwhite text-xs font-mono px-3 py-1 rounded-full">MT</span>
					</div>
					<h1 class="font-display font-semibold text-5xl md:text-6xl mb-2">Margaret "Maggie" Chen</h1>
					<p class="text-2xl text-wafs-gold font-display italic mb-8">Managing Partner — Tax Strategy</p>
					<div class="space-y-4 mb-10 text-warmwhite/80 font-sans">
						<a href="tel:2065555555" class="flex items-center gap-3 hover:text-warmwhite transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-wafs-gold" set:html={Phone} /> (206) 555-5555
						</a>
						<a href="mailto:mchen@washingtonacfs.com" class="flex items-center gap-3 hover:text-warmwhite transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-wafs-gold" set:html={Mail} /> mchen@washingtonacfs.com
						</a>
						<div class="flex items-center gap-3">
							<span class="w-5 h-5 flex items-center justify-center text-wafs-gold font-semibold">·</span> Founded WAFS in 2014
						</div>
					</div>
					<a href="/finance/contact" class="inline-flex items-center bg-wafs-gold hover:bg-wafs-gold/90 text-wafs-forest font-semibold text-lg px-8 py-4 rounded-md transition-colors">Schedule a Call with Maggie</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Body -->
	<section class="py-24 bg-warmwhite">
		<div class="container mx-auto px-6">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
				<div class="lg:col-span-8 space-y-12">
					<div>
						<h2 class="font-display text-3xl font-semibold text-wafs-forest mb-6">Biography</h2>
						<div class="prose-wafs space-y-6 text-[#4a5568] leading-relaxed">
							<p>Maggie Chen co-founded Washington Accounting & Financial Services in 2014 after 14 years at Deloitte's Seattle office, where she led the Pacific Northwest tax practice for closely held businesses. Her decision to leave a national firm wasn't a step down — it was a step closer to clients.</p>
							<p>At Deloitte, she recognized that Pacific Northwest business owners with real assets were often assigned to junior staff while senior partners chased Fortune 500 accounts. She believed that regional mid-market companies and founders deserved the same level of strategic, proactive tax planning that large corporations receive.</p>
							<p>Today, Maggie leads WAFS's tax practice and personally handles the firm's most complex engagements, including multi-state taxation, real estate tax structuring, and pre-transaction planning. She is known for finding elegant tax solutions to complex business restructurings and has extensive experience successfully representing clients before the IRS and the Washington State Department of Revenue.</p>
							<p>Outside the office, Maggie serves on the board of the Seattle Metropolitan Chamber of Commerce and mentors first-generation college students through the UW Foster School alumni network. She lives in Madison Park with her husband and two daughters.</p>
						</div>
					</div>
					<div class="bg-[#f0ede8] p-8 border-l-4 border-wafs-gold">
						<p class="font-display text-2xl leading-relaxed italic text-wafs-forest">"The highest-impact tax work I do isn't filing returns — it's preventing unnecessary tax bills that most business owners don't even know they're paying. That requires planning in September, not reacting in April."</p>
					</div>
				</div>
				<div class="lg:col-span-4 space-y-10">
					<div>
						<h3 class="font-sans font-semibold text-sm uppercase tracking-widest text-wafs-slate mb-4 border-b border-[#d4e6dc] pb-2">Focus Areas</h3>
						<ul class="space-y-3">
							{focusAreas.map((e) => (
								<li class="flex items-start gap-2 text-[#4a5568]">
									<div class="w-1.5 h-1.5 rounded-full bg-wafs-gold mt-2 shrink-0"></div>
									<span>{e}</span>
								</li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="font-sans font-semibold text-sm uppercase tracking-widest text-wafs-slate mb-4 border-b border-[#d4e6dc] pb-2">Industry Expertise</h3>
						<ul class="space-y-3">
							{industries.map((i) => (
								<li><a href={i.href} class="text-wafs-forest font-medium hover:text-wafs-gold transition-colors">{i.label}</a></li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="font-sans font-semibold text-sm uppercase tracking-widest text-wafs-slate mb-4 border-b border-[#d4e6dc] pb-2">Credentials & Affiliations</h3>
						<ul class="space-y-3 text-sm text-[#4a5568]">
							{credentials.map((c) => (<li>{c}</li>))}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
</FinanceLayout>
