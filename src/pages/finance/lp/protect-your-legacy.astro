---
import FinanceLandingLayout from "../../../components/finance/FinanceLandingLayout.astro";

const CheckIcon = `<circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path>`;

const problems = [
	{
		title: "The Advisor Silo",
		desc: "Your investment advisor optimizes for growth without knowing your marginal tax rate. Your CPA files taxes without knowing your investment allocation. Your estate attorney drafts documents without knowing your retirement income projections. No one is connecting the dots.",
	},
	{
		title: "The Reactive Tax Trap",
		desc: "Wealth management decisions made without tax awareness are expensive. A Roth conversion that lowers your lifetime tax bill by $200,000 requires knowing your future income, your estate goals, and your business exit timeline — simultaneously.",
	},
	{
		title: "The Unfinished Estate",
		desc: "Many families with significant assets have estate documents that are outdated, incomplete, or disconnected from their financial picture. A will signed in 2008 may not reflect a 2024 business valuation, updated beneficiary preferences, or new federal estate tax thresholds.",
	},
];

const wealthServices = [
	"Personal financial planning and retirement income modeling",
	"Roth conversion strategy and tax-efficient withdrawal planning",
	"Estate planning coordination with your attorney",
	"Investment portfolio oversight and asset allocation review",
	"Business owner exit and liquidity planning",
	"Insurance gap analysis",
	"Family wealth transfer planning",
];

const whoWeWorkWith = [
	"Business owners within 5 years of a liquidity event",
	"Executives with significant stock compensation (RSUs, options)",
	"Medical professionals and high-earning professionals",
	"Multi-generational family wealth situations",
	"Clients with $500K+ in investable assets",
];
---

<FinanceLandingLayout title="Protect Your Legacy | Estate Planning Seattle | WAFS" description="Protect your family's financial legacy with estate strategy and wealth planning from WAFS Seattle CPAs.">
	<!-- Hero -->
	<section class="relative flex min-h-[85vh] items-center bg-wafs-forest pt-36 pb-28 text-warmwhite">
		<div class="absolute inset-0 z-0" style="background-image:url('/images/finance/lp-legacy-bg.png'); background-size:cover; background-position:center; opacity:0.25;"></div>
		<div class="absolute inset-0 z-0 bg-gradient-to-b from-wafs-forest/85 via-wafs-forest/45 to-wafs-forest"></div>
		<div class="relative z-10 container mx-auto max-w-4xl px-6">
			<p class="mb-6 font-mono text-xs tracking-widest text-wafs-gold uppercase">Wealth &amp; Legacy Planning — Seattle, WA</p>
			<h1 class="font-display mb-8 max-w-3xl text-5xl leading-[0.95] font-semibold md:text-7xl">You've Built Something Real. Let's Make Sure It Lasts.</h1>
			<p class="mb-10 max-w-2xl text-lg leading-relaxed text-warmwhite/85 md:text-xl">WAFS integrates tax planning, investment oversight, and estate coordination under one roof — because your financial life doesn't operate in silos, and your advisors shouldn't either.</p>
			<a href="#contact-form" class="inline-flex h-14 items-center rounded-md bg-wafs-gold px-10 text-lg font-semibold text-wafs-forest transition-colors hover:bg-wafs-gold/90">Schedule My Wealth Planning Conversation</a>
		</div>
	</section>

	<!-- The problem -->
	<section class="bg-warmwhite py-20">
		<div class="container mx-auto max-w-5xl px-6">
			<h2 class="font-display mb-4 text-center text-3xl font-semibold text-wafs-forest md:text-4xl">The Problem With How Most Wealth Gets Managed</h2>
			<p class="mx-auto mb-14 max-w-2xl text-center text-charcoal">Three disciplines. Three different professionals. No one talking to each other.</p>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
				{problems.map((p) => (
					<div class="border-t-2 border-wafs-gold bg-warmcream p-8">
						<h3 class="font-display mb-4 text-xl font-semibold text-wafs-forest">{p.title}</h3>
						<p class="text-sm leading-relaxed text-charcoal">{p.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- What integrated planning looks like -->
	<section class="border-t border-lightsage bg-warmcream py-20">
		<div class="container mx-auto max-w-4xl px-6">
			<div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
				<div>
					<h2 class="font-display mb-6 text-3xl font-semibold text-wafs-forest">What Integrated Planning Looks Like</h2>
					<p class="mb-6 leading-relaxed text-charcoal">Robert Kimura holds both the CPA and CFP® designations — two of the most rigorous credentials in finance. That dual qualification lets him serve as the integrating voice across every dimension of your financial life.</p>
					<p class="mb-6 leading-relaxed text-charcoal">When you work with WAFS, a Roth conversion analysis incorporates your current marginal rate, your projected income at retirement, your estate goals, and your business exit timeline — all in a single conversation.</p>
					<p class="border-l-4 border-wafs-gold pl-6 font-display text-lg text-wafs-forest italic">"Robert was the first advisor who ever showed me how a Roth conversion would interact with my business sale taxes."</p>
					<p class="mt-3 text-sm font-semibold text-charcoal">M. Callahan — Retired Healthcare Executive</p>
				</div>
				<div>
					<div class="relative mx-auto w-full max-w-sm" style="height:320px;">
						<div class="absolute top-0 left-1/2 flex h-44 w-44 -translate-x-1/2 items-center justify-center rounded-full border-2 border-wafs-forest bg-wafs-forest/15">
							<p class="font-display px-4 text-center text-sm font-semibold text-wafs-forest">Tax Planning</p>
						</div>
						<div class="absolute bottom-0 left-4 flex h-44 w-44 items-center justify-center rounded-full border-2 border-wafs-evergreen bg-wafs-evergreen/15">
							<p class="font-display px-4 text-center text-sm font-semibold text-wafs-evergreen">Investment Oversight</p>
						</div>
						<div class="absolute right-4 bottom-0 flex h-44 w-44 items-center justify-center rounded-full border-2 border-wafs-slate bg-wafs-slate/15">
							<p class="font-display px-4 text-center text-sm font-semibold text-wafs-slate">Estate Coordination</p>
						</div>
						<div class="absolute top-1/2 left-1/2 z-10 -translate-x-1/2 -translate-y-1/3 rounded-sm bg-wafs-gold px-4 py-2">
							<p class="font-display text-center text-sm font-semibold text-wafs-forest">WAFS</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Services + who we work with -->
	<section class="border-t border-lightsage bg-warmwhite py-20">
		<div class="container mx-auto max-w-4xl px-6">
			<div class="grid grid-cols-1 gap-12 md:grid-cols-2">
				<div>
					<h3 class="font-display mb-8 text-2xl font-semibold text-wafs-forest">Wealth Planning Services</h3>
					<div class="space-y-3">
						{wealthServices.map((s) => (
							<div class="flex items-start gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 shrink-0 text-wafs-gold" set:html={CheckIcon} />
								<p class="text-nearblack">{s}</p>
							</div>
						))}
					</div>
				</div>
				<div>
					<h3 class="font-display mb-8 text-2xl font-semibold text-wafs-forest">Who We Work With</h3>
					<div class="space-y-3">
						{whoWeWorkWith.map((w) => (
							<div class="flex items-start gap-3">
								<span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wafs-gold"></span>
								<p class="text-charcoal">{w}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Meet Robert -->
	<section class="bg-wafs-forest py-20 text-warmwhite">
		<div class="container mx-auto max-w-4xl px-6">
			<div class="grid grid-cols-1 items-start gap-10 md:grid-cols-3">
				<div class="aspect-square overflow-hidden border border-warmwhite/20">
					<img src="/images/finance/team-robert.png" alt="Robert Kimura" class="h-full w-full object-cover" />
				</div>
				<div class="md:col-span-2">
					<div class="mb-4 flex gap-2">
						<span class="rounded-sm bg-warmwhite/10 px-2 py-1 font-mono text-xs text-warmwhite">CPA</span>
						<span class="rounded-sm bg-warmwhite/10 px-2 py-1 font-mono text-xs text-warmwhite">CFP®</span>
						<span class="rounded-sm bg-wafs-gold/20 px-2 py-1 font-mono text-xs text-wafs-gold">Co-Founder</span>
					</div>
					<h3 class="font-display mb-2 text-2xl font-semibold text-warmwhite">Robert Kimura, CPA, CFP®</h3>
					<p class="mb-6 text-sm font-medium text-warmwhite/70">Partner — Wealth &amp; Financial Planning</p>
					<p class="leading-relaxed text-warmwhite/85">Robert co-founded WAFS in 2014 driven by a conviction that tax planning and financial planning should never operate in separate silos. His dual CPA and CFP® credentials let him serve as the integrating voice — connecting your annual tax strategy with your long-term wealth goals in a way that most advisors simply cannot.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact form -->
	<section id="contact-form" class="bg-warmcream py-20">
		<div class="container mx-auto max-w-2xl px-6">
			<div class="mb-10 text-center">
				<h2 class="font-display mb-4 text-3xl font-semibold text-wafs-forest md:text-4xl">Schedule Your Wealth Planning Conversation</h2>
				<p class="text-charcoal">All consultations are confidential. No obligation.</p>
			</div>
			<form class="space-y-6 border border-lightsage bg-white p-8">
				<div>
					<label for="name" class="mb-1.5 block text-sm font-semibold text-wafs-forest">Full Name</label>
					<input type="text" id="name" class="mt-1 w-full rounded-sm border border-lightsage bg-white px-4 py-2.5 text-sm text-nearblack focus:border-wafs-gold focus:ring-2 focus:ring-wafs-gold/30 focus:outline-none" />
				</div>
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					<div>
						<label for="email" class="mb-1.5 block text-sm font-semibold text-wafs-forest">Email</label>
						<input type="email" id="email" class="mt-1 w-full rounded-sm border border-lightsage bg-white px-4 py-2.5 text-sm text-nearblack focus:border-wafs-gold focus:ring-2 focus:ring-wafs-gold/30 focus:outline-none" />
					</div>
					<div>
						<label for="phone" class="mb-1.5 block text-sm font-semibold text-wafs-forest">Phone</label>
						<input type="tel" id="phone" class="mt-1 w-full rounded-sm border border-lightsage bg-white px-4 py-2.5 text-sm text-nearblack focus:border-wafs-gold focus:ring-2 focus:ring-wafs-gold/30 focus:outline-none" />
					</div>
				</div>
				<div>
					<label class="mb-1.5 block text-sm font-semibold text-wafs-forest">Primary Focus</label>
					<select class="mt-1 w-full rounded-sm border border-lightsage bg-white px-4 py-2.5 text-sm text-nearblack focus:border-wafs-gold focus:ring-2 focus:ring-wafs-gold/30 focus:outline-none">
						<option value="">What matters most to you right now?</option>
						<option value="retirement">Retirement income planning</option>
						<option value="estate">Estate planning coordination</option>
						<option value="investment">Investment oversight</option>
						<option value="business-exit">Business owner transition</option>
						<option value="general">General financial planning</option>
					</select>
				</div>
				<div>
					<label class="mb-1.5 block text-sm font-semibold text-wafs-forest">Approximate Investable Assets (Optional)</label>
					<select class="mt-1 w-full rounded-sm border border-lightsage bg-white px-4 py-2.5 text-sm text-nearblack focus:border-wafs-gold focus:ring-2 focus:ring-wafs-gold/30 focus:outline-none">
						<option value="">Prefer not to say</option>
						<option value="under-500k">Under $500K</option>
						<option value="500k-2m">$500K – $2M</option>
						<option value="2m-5m">$2M – $5M</option>
						<option value="5m-plus">$5M+</option>
					</select>
				</div>
				<div>
					<label for="message" class="mb-1.5 block text-sm font-semibold text-wafs-forest">Brief Message (Optional)</label>
					<textarea id="message" rows="3" placeholder="Any context that would help us prepare for the conversation..." class="mt-1 w-full resize-y rounded-sm border border-lightsage bg-white px-4 py-2.5 text-sm text-nearblack placeholder-charcoal/40 focus:border-wafs-gold focus:ring-2 focus:ring-wafs-gold/30 focus:outline-none"></textarea>
				</div>
				<button type="button" title="This form isn't wired up to send yet — call us directly instead." class="h-14 w-full rounded-md bg-wafs-gold text-base font-semibold text-wafs-forest transition-colors hover:bg-wafs-gold/90">Schedule My Wealth Planning Conversation</button>
			</form>
		</div>
	</section>
</FinanceLandingLayout>
