---
import Layout from "../layouts/Layout.astro";

interface Section {
	number: string;
	title: string;
	body: string;
}

const sections: Section[] = [
	{
		number: "1",
		title: "Information We Collect",
		body: "When you submit a contact form, intake form, or chat with our AI assistant on this site, we collect the information you provide directly — typically your name, email address, phone number, and any message or details you share. We do not collect this information through any means other than what you actively submit.",
	},
	{
		number: "2",
		title: "How We Use Your Information",
		body: "We use the information you submit solely to respond to your inquiry, follow up on a consultation request, or provide the service you asked about. We do not sell, rent, or trade your personal information to third parties for marketing purposes.",
	},
	{
		number: "3",
		title: "Third-Party Services",
		body: "This site relies on a small number of third-party services to operate: email delivery (Resend) to route form submissions and chat leads to our inbox, Google reCAPTCHA to protect forms from spam and abuse, and OpenAI's API to power the AI chat assistant. Information you submit through a form or chat conversation may be processed by these providers as part of delivering that functionality, subject to their own privacy policies. We may also use website analytics tools (such as Google Analytics) to understand overall site traffic and usage patterns; this data is aggregated and is not used to personally identify you.",
	},
	{
		number: "4",
		title: "Cookies",
		body: "This site may use cookies or similar technologies from the third-party services listed above (for example, to support spam protection or analytics). We do not use cookies for third-party advertising or to sell your information.",
	},
	{
		number: "5",
		title: "Data Retention",
		body: "We retain information submitted through forms and chat conversations only as long as needed to respond to your inquiry and maintain reasonable business records. You may request that we delete information you've submitted at any time by contacting us using the information below.",
	},
	{
		number: "6",
		title: "Your Rights",
		body: "You may contact us at any time to ask what information we hold about you, request a correction, or request deletion. We will respond to reasonable requests in a timely manner.",
	},
	{
		number: "7",
		title: "Children's Privacy",
		body: "This site is not directed at children under 13, and we do not knowingly collect personal information from children under 13.",
	},
	{
		number: "8",
		title: "Changes to This Policy",
		body: "We may update this Privacy Policy from time to time to reflect changes in our practices or for other operational, legal, or regulatory reasons. The revision date below reflects the most recent update.",
	},
	{
		number: "9",
		title: "Contact Us",
		body: "If you have questions about this Privacy Policy or how your information is handled, contact us at brad@ascendsmartly.com.",
	},
];
---

<Layout title="Privacy Policy | Ascend Consulting" description="How Ascend Consulting collects, uses, and protects information submitted through this site's contact forms and AI chat assistant." bare noindex>
	<div class="min-h-screen bg-white">
		<div class="bg-[#0A1628] py-10">
			<div class="mx-auto max-w-4xl px-6">
				<a href="/" class="mb-6 inline-flex items-center gap-2 text-sm text-white/60 transition-colors hover:text-white/80">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m12 19-7-7 7-7" /><path d="M19 12H5" />
					</svg>
					Back to Ascend Consulting
				</a>
				<h1 class="text-3xl text-white md:text-4xl">Privacy Policy</h1>
				<p class="mt-2 text-sm text-white/60">Revision Date: August 12, 2026</p>
			</div>
		</div>

		<div class="mx-auto max-w-4xl px-6 py-14">
			<div class="space-y-10 leading-relaxed text-gray-700">
				{
					sections.map((section) => (
						<div>
							<h2 class="mb-3 flex items-baseline gap-2 text-lg font-bold text-[#0A1628]">
								<span class="shrink-0 font-mono text-sm text-accent">{section.number}.</span>
								{section.title}
							</h2>
							<div class="space-y-3 border-l-2 border-gray-100 pl-5 text-[15px] leading-relaxed text-gray-600">
								<p>{section.body}</p>
							</div>
						</div>
					))
				}
			</div>

			<div class="mt-14 border-t border-gray-200 pt-8">
				<p class="text-xs text-gray-400">
					&copy; {new Date().getFullYear()} Ascend Consulting LLC. All rights reserved. For questions regarding this policy, contact{" "}
					<a href="mailto:brad@ascendsmartly.com" class="text-gray-500 underline hover:text-gray-700">brad@ascendsmartly.com</a>.
				</p>
			</div>
		</div>
	</div>
</Layout>
