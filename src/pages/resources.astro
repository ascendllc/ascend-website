---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { partners, partnershipCallouts, testimonials, faqs } from "../data/resources";
import { portfolio } from "../data/resources";
import { caseStudies } from "../data/caseStudies";

const toImagePath = (p: string) => p.replace(/^\//, "/images/");

const tabs = [
	{ label: "Partners", anchor: "partners" },
	{ label: "Case Studies", anchor: "case-studies" },
	{ label: "Portfolio", anchor: "portfolio" },
	{ label: "Testimonials", anchor: "testimonials" },
	{ label: "FAQs", anchor: "faq" },
];

const ArrowRight = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
const ArrowRightSm = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
const ExternalLink = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>`;
const Check = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>`;
const Play = `<svg viewBox="0 0 24 24" width="24" height="24"><polygon points="5,3 19,12 5,21" fill="white"></polygon></svg>`;

// Generated directly from the same `faqs`/`testimonials` arrays rendered below, so
// the schema can never drift out of sync with what's actually visible on the page.
const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};
const reviewSchema = testimonials.map((t) => ({
	"@context": "https://schema.org",
	"@type": "Review",
	itemReviewed: { "@type": "ProfessionalService", name: site.name },
	author: { "@type": "Person", name: t.name, jobTitle: t.role, worksFor: { "@type": "Organization", name: t.org } },
	reviewBody: t.quote,
}));
---

<Layout
	title="Resources | Ascend Consulting"
	description="Explore Ascend Consulting's partner network, real-world case studies, portfolio work, client testimonials, and frequently asked questions."
	bare
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	{reviewSchema.map((review) => <script type="application/ld+json" set:html={JSON.stringify(review)} />)}
	<div class="min-h-screen bg-white">
		<header id="res-header" class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 shadow-sm backdrop-blur-sm">
			<div class="container mx-auto flex items-center justify-between gap-6 px-6 py-3 md:px-12">
				<div class="flex items-center gap-4">
					<a href="/" class="flex shrink-0 items-center gap-2">
						<img src="/images/ascend-logo-color.webp" alt="Ascend Consulting" class="h-8" />
					</a>
					<span class="hidden text-lg text-gray-300 sm:block">/</span>
					<span class="hidden text-sm font-semibold text-primary sm:block">Resources</span>
				</div>
				<nav class="hidden items-center gap-1 md:flex">
					{
						tabs.map((tab) => (
							<a href={`#${tab.anchor}`} class="rounded px-3 py-1.5 text-sm font-medium text-gray-500 transition-colors hover:bg-gray-50 hover:text-primary">
								{tab.label}
							</a>
						))
					}
				</nav>
				<div class="flex items-center gap-3">
					<a href="/" class="hidden items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-primary sm:inline-flex">
						&larr; Home
					</a>
					<a
						href={site.booking}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 rounded-sm bg-accent px-4 py-2 text-sm font-medium text-white transition-all hover:bg-accent/90"
						set:html={`Consultation ${ArrowRightSm}`}
					/>
					<button type="button" id="res-mobile-toggle" class="p-1 md:hidden" aria-label="Toggle navigation">
						<span class="mb-1 block h-px w-5 bg-gray-600"></span>
						<span class="mb-1 block h-px w-5 bg-gray-600"></span>
						<span class="block h-px w-5 bg-gray-600"></span>
					</button>
				</div>
			</div>
			<div id="res-mobile-menu" class="hidden flex-col gap-3 border-t border-gray-100 bg-white px-6 py-4 md:hidden">
				{tabs.map((tab) => (
					<a href={`#${tab.anchor}`} class="res-mobile-link py-1 text-left font-medium text-gray-700">{tab.label}</a>
				))}
				<a href="/" class="border-t border-gray-100 pt-2 text-sm text-gray-500">&larr; Back to Home</a>
			</div>
		</header>

		<!-- Hero -->
		<section class="bg-primary py-16 md:py-20">
			<div class="container mx-auto max-w-4xl px-6 md:px-12">
				<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">Ascend Consulting</p>
				<h1 class="mb-4 text-4xl leading-snug text-white md:text-5xl" style="font-family: var(--font-serif);">Resources</h1>
				<p class="max-w-2xl text-lg leading-relaxed text-white/65">
					Partners, real-world case studies, portfolio work, client testimonials, and answers to
					common questions — everything you need to make a confident decision.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					{
						tabs.map((tab) => (
							<a
								href={`#${tab.anchor}`}
								class="rounded-full border border-white/20 px-4 py-1.5 text-sm font-medium text-white/60 transition-all hover:border-white/40 hover:text-white"
							>
								{tab.label}
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- Partners -->
		<section id="partners" class="relative overflow-hidden bg-white py-20 md:py-28">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute top-0 right-0 h-[500px] w-[500px] rounded-full bg-primary/3 blur-[120px]"></div>
			</div>
			<div class="container relative z-10 mx-auto px-6 md:px-12">
				<div class="mx-auto mb-16 max-w-3xl text-center">
					<p class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">Trusted Partners</p>
					<h2 class="mb-6 text-4xl text-primary md:text-5xl" style="font-family: var(--font-serif);">A Network Built for Your Needs</h2>
					<p class="text-lg leading-relaxed text-gray-600">
						When your needs extend beyond marketing strategy, Ascend connects you with a select group of trusted specialists — each vetted, experienced, and aligned with our commitment to excellence.
					</p>
				</div>

				<div class="mb-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						partners.map((p) => (
							<a href={`/partners#${p.slug}`} class="group block rounded-sm border border-gray-100 bg-gray-50 p-6 transition-all hover:border-accent/30 hover:shadow-md">
								<div class="mb-4 h-1 w-8 bg-accent"></div>
								<p class="mb-0.5 text-lg font-bold text-primary transition-colors group-hover:text-accent">{p.name}</p>
								<p class="mb-1 text-sm text-gray-500">{p.role}</p>
								<p class="text-sm font-semibold text-accent">{p.org}</p>
							</a>
						))
					}
				</div>

				<div class="text-center">
					<a href="/partners" class="inline-flex items-center gap-2 rounded-sm bg-primary px-8 py-4 font-semibold text-white shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary/90" set:html={`Meet the Full Partner Network ${ArrowRight}`} />
				</div>

				{
					partnershipCallouts.map((box) => (
						<div class="relative mt-12 overflow-hidden rounded-sm p-8 md:p-12" style={box.bg === "primary" ? "background-color: var(--color-primary);" : `background-color:${box.bg};`}>
							<div class="pointer-events-none absolute top-0 right-0 h-64 w-64 -translate-y-1/2 translate-x-1/3 rounded-full bg-accent/10 blur-3xl"></div>
							<div class="relative z-10">
								<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">{box.eyebrow}</p>
								<h3 class="mb-4 text-2xl font-bold text-white md:text-3xl">{box.title}</h3>
								{box.paragraphs.map((para) => (
									<p class="mb-6 text-lg leading-relaxed text-white/80 last-of-type:mb-8">
										{para.map((seg) => (seg.bold ? <span class="font-semibold text-white">{seg.text}</span> : seg.text))}
									</p>
								))}
								<div class="mb-8 flex flex-wrap gap-3">
									{box.tags.map((tag) => (
										<span class="rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm text-white/90">{tag}</span>
									))}
								</div>
								<div class="flex flex-wrap items-center gap-6">
									<a href={box.cta.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3 font-medium text-white shadow-md transition-all hover:-translate-y-0.5 hover:bg-accent/90" set:html={`${box.cta.label} ${ArrowRightSm}`} />
									{box.logo && (
										<a href={box.logo.href} target="_blank" rel="noopener noreferrer" aria-label="Visit NineStone Partners website">
											<img src={box.logo.src} alt="" class="h-10 brightness-0 invert transition-opacity hover:opacity-80 md:h-12" />
										</a>
									)}
								</div>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Case Studies -->
		<section id="case-studies" class="border-t border-gray-100 bg-gray-50 py-20 md:py-28">
			<div class="container mx-auto px-6 md:px-12">
				<div class="mb-16 text-center">
					<p class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">Real Results</p>
					<h2 class="mb-4 text-4xl font-bold text-primary md:text-5xl">Case Studies</h2>
					<div class="mx-auto mb-6 h-1 w-16 bg-accent"></div>
					<p class="mx-auto max-w-2xl text-xl text-gray-600">
						Real results from real organizations. See how strategic clarity and creative execution drive transformative growth.
					</p>
				</div>
				<div class="grid gap-8 md:grid-cols-2">
					{
						caseStudies.map((cs) => (
							<div class="group overflow-hidden rounded-sm border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
								<div class="relative h-52 overflow-hidden">
									<img src={toImagePath(cs.heroImage)} alt={cs.title} class={`h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 ${cs.heroObjectPosition ?? "object-center"}`} loading="lazy" />
									<div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent"></div>
									<div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
										{cs.tags.slice(0, 2).map((tag) => (
											<span class="rounded-full border border-white/30 bg-white/20 px-3 py-1 text-xs text-white backdrop-blur-sm">{tag}</span>
										))}
									</div>
								</div>
								<div class="p-8">
									<p class="mb-2 text-xs font-bold tracking-widest text-accent uppercase">{cs.client}</p>
									<h3 class="mb-3 text-xl leading-snug font-bold text-primary transition-colors group-hover:text-accent">{cs.client} — {cs.title}</h3>
									<p class="mb-6 line-clamp-3 text-sm leading-relaxed text-gray-600">{cs.tagline}</p>
									<a href={`/case-study/${cs.slug}`} class="inline-flex items-center gap-2 rounded-sm bg-primary px-6 py-3 text-sm font-medium text-white transition-all duration-200 group-hover:bg-accent" set:html={`Read Case Study ${ArrowRightSm}`} />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Ascend in Action (video) -->
		<section class="border-t border-white/5 bg-[#0A1628] py-14">
			<div class="container mx-auto max-w-5xl px-6 md:px-12">
				<div class="grid items-center gap-10 md:grid-cols-2">
					<div>
						<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">Ascend in Action</p>
						<h2 class="mb-4 text-2xl leading-snug text-white md:text-3xl" style="font-family: var(--font-serif);">From dated to dynamic. A full brand and digital refresh.</h2>
						<p class="text-sm leading-relaxed text-white/55">
							When Ashdon Golf came to Ascend, their digital presence wasn't reflecting the quality of their product. We rebuilt it from the ground up — clean design, modern visuals, and a user experience built to drive engagement and sales. This is what Ascend's full marketing solutions look like in practice.
						</p>
					</div>
					<div class="relative aspect-video overflow-hidden rounded-lg border border-white/10 bg-black shadow-2xl">
						<video id="ashdon-video" src="/videos/ashdon-brand-refresh.mp4" poster="/images/ashdon-poster.jpg" class="absolute inset-0 h-full w-full object-cover" playsinline preload="metadata"></video>
						<div id="ashdon-play-overlay" class="absolute inset-0 flex flex-col items-center justify-center transition-opacity duration-300" style="background: rgba(10,22,40,0.65);">
							<button type="button" id="ashdon-play-btn" class="group flex flex-col items-center gap-2 focus:outline-none">
								<span class="flex h-14 w-14 items-center justify-center rounded-full bg-accent shadow-xl transition-all group-hover:scale-105 group-hover:bg-accent/80">
									<svg viewBox="0 0 24 24" class="h-6 w-6 fill-white" style="margin-left: 3px;"><polygon points="5,3 19,12 5,21"></polygon></svg>
								</span>
								<span class="text-xs font-semibold tracking-wide text-white/80 transition-colors group-hover:text-white">Watch the Transformation</span>
							</button>
						</div>
					</div>
				</div>
				<div class="mt-10 flex flex-col gap-5 border-t border-white/10 pt-8 sm:flex-row sm:items-center">
					<p class="flex-1 text-sm leading-relaxed text-white/55">
						Want to see the full solution in action? Visit the live Ashdon Golf site to experience the brand, design, and commerce platform Ascend built from the ground up.
					</p>
					<a href="https://www.ashdongolf.com/" target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-medium text-white shadow-md transition-all hover:-translate-y-0.5 hover:bg-accent/80" set:html={`Explore the Ashdon Golf Website ${ExternalLink}`} />
				</div>
			</div>
		</section>

		<!-- Portfolio -->
		<section id="portfolio" class="bg-white py-20 md:py-28">
			<div class="container mx-auto px-6 md:px-12">
				<div class="mb-16 text-center">
					<p class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">Additional Work</p>
					<h2 class="mb-4 text-4xl font-bold text-primary md:text-5xl">Portfolio</h2>
					<div class="mx-auto mb-6 h-1 w-16 bg-accent"></div>
					<p class="mx-auto max-w-2xl text-xl text-gray-600">Organizations built and launched from the ground up — strategy, brand, design, and execution.</p>
				</div>
				<div class="grid gap-8 md:grid-cols-3">
					{
						portfolio.map((p) => (
							<div class="group flex flex-col overflow-hidden rounded-sm border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
								{p.screenshot ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer" class="block overflow-hidden">
										<img src={toImagePath(p.screenshot)} alt={`${p.name} website screenshot`} class="h-48 w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
									</a>
								) : (
									<a href={p.url} target="_blank" rel="noopener noreferrer" class="block">
										<div class="flex h-48 w-full items-center justify-center" style={`background-color:${p.accent}`}>
											<span class="flex items-center gap-2 text-sm font-medium text-white/60" set:html={`${ExternalLink} ${p.displayUrl}`} />
										</div>
									</a>
								)}
								<div class="h-1 w-full" style={`background-color:${p.accent}`}></div>
								<div class="flex flex-1 flex-col p-8">
									<div class="mb-5">
										<h3 class="mb-1 text-2xl font-bold text-primary transition-colors group-hover:text-accent">{p.name}</h3>
										<a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline" set:html={`${ExternalLink} ${p.displayUrl}`} />
									</div>
									<p class="mb-6 border-l-2 border-gray-100 pl-4 text-sm leading-relaxed text-gray-500">{p.whatTheyDo}</p>
									<div class="mb-6 flex-1">
										<p class="mb-3 text-xs font-bold tracking-widest text-primary uppercase">{p.contributionLabel ?? "Ascend's Contribution"}</p>
										<ul class="space-y-2">
											{p.whatBradDid.map((item) => (
												<li class="flex items-start gap-2 text-sm text-gray-600">
													<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-accent" set:html={Check.match(/<path.*<\/path>/s)?.[0]} />
													{item}
												</li>
											))}
										</ul>
									</div>
									<div class="mb-6 flex flex-wrap gap-2">
										{p.tags.map((tag) => (
											<span class="rounded-full border border-gray-100 bg-gray-50 px-3 py-1 text-xs text-gray-500">{tag}</span>
										))}
									</div>
									<a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-primary px-6 py-3 text-sm font-medium text-white transition-all duration-200 group-hover:bg-accent" set:html={`Visit Site ${ArrowRightSm}`} />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Testimonials -->
		<section id="testimonials" class="relative overflow-hidden border-t border-orange-400/20 bg-accent py-20 md:py-28">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute top-0 right-0 h-[600px] w-[600px] rounded-full bg-orange-300/20 blur-[140px]"></div>
				<div class="absolute bottom-0 left-0 h-[500px] w-[500px] rounded-full bg-primary/30 blur-[120px]"></div>
			</div>
			<div class="container relative z-10 mx-auto px-6 md:px-12">
				<div class="mb-16 text-center">
					<p class="mb-4 text-xs font-bold tracking-widest text-white/60 uppercase">Client Voices</p>
					<h2 class="mb-4 text-4xl font-bold text-white md:text-5xl">What Leaders Say</h2>
					<div class="mx-auto mb-6 h-1 w-16 bg-white/60"></div>
					<p class="mx-auto max-w-2xl text-xl text-white/80">
						Hear from the people who've worked alongside Brad and seen the results firsthand.
					</p>
				</div>
				<div class="grid gap-6 md:grid-cols-2">
					{
						testimonials.map((t) => (
							<div class="flex flex-col gap-6 rounded-sm border border-white/25 bg-white/15 p-8">
								<p class="text-lg leading-relaxed text-white">"{t.quote}"</p>
								<div>
									<p class="font-bold text-white">{t.name}</p>
									<p class="text-sm text-white/70">{t.role}</p>
									<p class="text-sm font-semibold text-white/90">{t.org}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- FAQs -->
		<section id="faq" class="border-t border-gray-100 bg-gray-50 py-20 md:py-28">
			<div class="container mx-auto max-w-6xl px-6 md:px-12">
				<div class="mb-16 text-center">
					<p class="mb-4 text-xs font-bold tracking-widest text-accent uppercase">Got Questions?</p>
					<h2 class="mb-6 text-4xl text-primary md:text-5xl" style="font-family: var(--font-serif);">Frequently Asked Questions</h2>
					<div class="mx-auto h-1 w-16 bg-accent"></div>
				</div>
				<div id="faq-grid" class="grid grid-cols-1 items-start gap-3 md:grid-cols-2">
					{
						faqs.map((item, i) => (
							<div class:list={["faq-item", "overflow-hidden rounded-sm border border-gray-200 bg-white", { "faq-extra hidden md:block": i >= 3 }]}>
								<details class="group">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-7 py-5 text-left font-semibold text-primary transition-colors hover:text-accent">
										<span class="text-base leading-snug md:text-lg">{item.q}</span>
										<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-gray-200 bg-gray-50 text-lg font-bold text-accent shadow-sm transition-transform duration-200 group-open:rotate-45">
											+
										</span>
									</summary>
									<div class="border-t border-gray-100 px-7 pt-5 pb-6 text-base leading-relaxed text-gray-600">
										{item.a}
									</div>
								</details>
							</div>
						))
					}
				</div>
				<div id="faq-show-more" class="mt-6 text-center md:hidden">
					<button type="button" id="faq-show-more-btn" class="inline-flex items-center gap-2 border-b-2 border-primary pb-0.5 font-bold text-primary transition-colors hover:border-accent hover:text-accent" set:html={`Show all questions ${ArrowRightSm}`} />
				</div>
				<div class="mt-10 text-center">
					<p class="mb-4 text-gray-500">Still have questions?</p>
					<a href={site.booking} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border-b-2 border-primary pb-0.5 font-bold text-primary transition-colors hover:border-accent hover:text-accent" set:html={`Book a free consultation ${ArrowRightSm}`} />
				</div>
			</div>
		</section>

		<footer class="border-t border-gray-800 bg-gray-900 py-10 text-gray-400">
			<div class="container mx-auto flex flex-col items-center justify-between gap-4 px-6 md:flex-row md:px-12">
				<a href="/"><img src="/images/ascend-logo-white.webp" alt="Ascend Consulting" class="h-8 opacity-80" loading="lazy" /></a>
				<p class="text-sm">&copy; {new Date().getFullYear()} Ascend Consulting. All rights reserved.</p>
				<a href="/" class="text-sm text-gray-500 transition-colors hover:text-white">&larr; Back to Home</a>
			</div>
		</footer>
	</div>

	<script>
		const mobileToggle = document.getElementById("res-mobile-toggle");
		const mobileMenu = document.getElementById("res-mobile-menu");
		mobileToggle?.addEventListener("click", () => {
			mobileMenu?.classList.toggle("hidden");
			mobileMenu?.classList.toggle("flex");
		});
		document.querySelectorAll(".res-mobile-link").forEach((link) => {
			link.addEventListener("click", () => {
				mobileMenu?.classList.add("hidden");
				mobileMenu?.classList.remove("flex");
			});
		});

		const video = document.getElementById("ashdon-video") as HTMLVideoElement | null;
		const overlay = document.getElementById("ashdon-play-overlay");
		const playBtn = document.getElementById("ashdon-play-btn");
		function hideOverlay() {
			overlay?.classList.add("opacity-0", "pointer-events-none");
		}
		function showOverlay() {
			overlay?.classList.remove("opacity-0", "pointer-events-none");
		}
		playBtn?.addEventListener("click", () => {
			video?.play();
			video?.setAttribute("controls", "true");
			hideOverlay();
		});
		video?.addEventListener("pause", showOverlay);
		video?.addEventListener("ended", showOverlay);

		const showMoreBtn = document.getElementById("faq-show-more-btn");
		showMoreBtn?.addEventListener("click", () => {
			document.querySelectorAll(".faq-extra").forEach((el) => el.classList.remove("hidden"));
			document.getElementById("faq-show-more")?.classList.add("hidden");
		});
	</script>
</Layout>
