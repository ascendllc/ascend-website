---
import Layout from "../../layouts/Layout.astro";
import { insights } from "../../data/insights";
---

<Layout
	title="Insights | Ascend Consulting"
	description="Guides and explainers on brand strategy, growth marketing, and modern search — SEO, GEO, and AEO — from Ascend Consulting."
>
	<section class="relative flex min-h-[40vh] items-center overflow-hidden bg-primary pt-28 pb-16 md:pt-32">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div class="absolute -top-[20%] -right-[10%] h-[70%] w-[70%] rounded-full bg-secondary/30 blur-[120px]"></div>
			<div class="absolute -bottom-[20%] -left-[10%] h-[60%] w-[60%] rounded-full bg-accent/20 blur-[100px]"></div>
		</div>
		<div class="container relative z-10 mx-auto px-6 md:px-12">
			<div class="mx-auto max-w-2xl text-center">
				<h1 class="text-4xl leading-tight text-white md:text-6xl">Insights</h1>
				<p class="mx-auto mt-6 max-w-xl text-lg font-light leading-relaxed text-white/80 md:text-xl">
					Guides and explainers on brand strategy, growth marketing, and modern search — written by Ascend Consulting.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-white py-20 md:py-28">
		<div class="container mx-auto px-6 md:px-12">
			<div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
				{
					insights.map((insight) => (
						<a
							href={`/insights/${insight.slug}`}
							class="group flex flex-col rounded-sm border border-gray-100 bg-gray-50 p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
						>
							<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">
								{insight.dateDisplay} &middot; {insight.readingTime}
							</p>
							<h2 class="mb-3 text-xl font-bold text-primary transition-colors group-hover:text-accent">{insight.title}</h2>
							<p class="flex-1 leading-relaxed text-gray-600">{insight.excerpt}</p>
							<p class="mt-6 text-sm font-bold text-accent">Read More &rarr;</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Layout>
