---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const NAVY = "#0A1628";
const ORANGE = "#E8622A";

const DEMO_URL = "/law";
const LANDING_PAGES_URL = "/law/demo/landing-pages";

const ArrowRight = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
const ExternalLink = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>`;
const ExternalLinkSm = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>`;
const ExternalLinkXs = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>`;
const Calendar = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>`;
const CalendarLg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>`;
const Mail = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>`;

const Palette = `<path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>`;
const Globe = `<path d="M22 7 13.5 15.5 8.5 10.5 2 17"></path><path d="M16 7h6v6"></path>`;
const TrendingUp = `<path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path>`;
const Search = `<path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle>`;
const FileText = `<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path>`;
const Megaphone = `<path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"></path><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"></path><path d="M8 6v8"></path>`;
const Target = `<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>`;
const Bot = `<path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path>`;

const included = [
	{ icon: Palette, label: "Brand Identity & Visual Design", desc: "Logo, color system, typography, and a cohesive visual language that conveys authority and trustworthiness — essential for any firm competing for high-value clients." },
	{ icon: Globe, label: "Website Design & Development", desc: "A professionally designed, fast-loading website built for conversion — with clear practice area pages, attorney bios, results showcases, and a seamless consultation booking flow." },
	{ icon: TrendingUp, label: "Go-to-Market Strategy", desc: "A clear launch plan: who you target, how you position against competing firms, what channels you lead with, and how you measure success from day one." },
	{ icon: Search, label: "SEO + AEO/IEO Optimization", desc: "Traditional search engine optimization combined with Answer Engine Optimization and Intent-based Engine Optimization — so your firm surfaces in both Google results and AI-generated answers when potential clients are searching." },
	{ icon: FileText, label: "Content Creation", desc: "Thought leadership articles, practice area pages, case result highlights, and educational content that builds credibility, improves search visibility, and keeps your audience coming back." },
	{ icon: Megaphone, label: "Google Ads & Meta Ads", desc: "Precision-targeted paid campaigns built around your practice areas — with dedicated landing pages engineered to convert ad traffic into consultation requests." },
	{ icon: Target, label: "Dedicated Ad Landing Pages", desc: "Each campaign gets its own focused landing page — no distractions, above-the-fold lead forms, and copy tailored to the exact audience being targeted." },
	{ icon: Bot, label: "AI Chat Assistant", desc: "A live AI chatbot trained on your firm's content answers visitor questions in real time, 24/7 — capturing leads even when your team isn't available." },
];

const landingPages = ["Personal Injury — Google Ads", "Estate Planning — Meta Ads", "Business Law — Google Ads", "Employment Law — Meta Ads"];
---

<Layout
	title="Marketing for Law Firms & Attorneys | Ascend Consulting"
	description="Ascend delivers full-service marketing for attorneys and law firms — branding, SEO, AEO, content, Google Ads, Meta Ads, and AI chat."
	bare
	noindex
>
	<div class="min-h-screen bg-white font-sans">
		<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 shadow-sm backdrop-blur-sm">
			<div class="container mx-auto flex items-center justify-between gap-6 px-6 py-3 md:px-12">
				<a href="/" class="flex shrink-0 items-center gap-2">
					<img src="/images/ascend-logo-color.webp" alt="Ascend Consulting" class="h-8" />
				</a>
				<div class="flex items-center gap-3">
					<a href="/provisors" class="hidden text-sm font-medium text-gray-500 transition-colors hover:text-[#E8622A] sm:inline">← Back to ProVisors</a>
					<a
						href={site.booking}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 rounded-sm px-4 py-2 text-sm font-medium text-white transition-all"
						style={`background-color:${ORANGE}`}
						set:html={`Meet with Ascend ${ArrowRight}`}
					/>
				</div>
			</div>
		</header>

		<!-- Hero -->
		<section class="relative overflow-hidden pt-20 pb-24 text-white" style={`background-color:${NAVY}`}>
			<div class="absolute inset-0 opacity-5" style="background-image:url('/images/provisors-hero-bg.jpg'); background-size:cover; background-position:center;"></div>
			<div class="relative mx-auto max-w-5xl px-6">
				<div class="mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-bold tracking-widest uppercase" style={`background-color:${ORANGE}33; border-color:${ORANGE}66; color:#f0a080`}>
					Legal Industry Marketing
				</div>
				<h1 class="mb-5 max-w-3xl text-4xl leading-tight md:text-5xl lg:text-6xl" style="font-family: var(--font-serif);">
					Everything your firm needs to compete <span style={`color:${ORANGE}`}>digitally.</span>
				</h1>
				<p class="mb-8 max-w-2xl text-lg leading-relaxed text-white/65">
					Ascend Consulting delivers a complete marketing system for attorneys and law firms — from brand identity and website through SEO, content, paid ads, and an AI assistant that converts visitors around the clock. See exactly what this looks like, built for a real demo firm.
				</p>
				<div class="flex flex-col gap-4 sm:flex-row">
					<a href={DEMO_URL} class="inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-bold text-white transition-colors" style={`background-color:${ORANGE}`} set:html={`View the Live Demo ${ExternalLinkSm}`} />
					<a href={site.booking} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-sm border border-white/25 px-7 py-3.5 font-semibold text-white/75 transition-colors hover:border-white/50 hover:text-white" set:html={`${Calendar} Schedule a Conversation`} />
				</div>
			</div>
		</section>

		<!-- Live Demo -->
		<section class="border-b border-gray-200 bg-gray-50 py-16">
			<div class="mx-auto max-w-5xl px-6">
				<div class="mb-10 text-center">
					<p class="mb-3 text-xs font-bold tracking-widest uppercase" style={`color:${ORANGE}`}>Live Demo</p>
					<h2 class="mb-4 text-3xl md:text-4xl" style={`font-family: var(--font-serif); color:${NAVY}`}>Washington Law — a fictitious firm, real capabilities.</h2>
					<p class="mx-auto max-w-2xl text-base leading-relaxed text-gray-500">Every element shown in this demo — the brand, the website, the content, the ads, and the AI assistant — represents exactly what Ascend builds for legal professionals and their firms.</p>
				</div>
				<div class="overflow-hidden rounded-xl border border-gray-200 shadow-2xl">
					<div class="flex items-center gap-2 bg-gray-800 px-4 py-2.5">
						<span class="h-3 w-3 rounded-full bg-red-400/70"></span>
						<span class="h-3 w-3 rounded-full bg-yellow-400/70"></span>
						<span class="h-3 w-3 rounded-full bg-green-400/70"></span>
						<span class="ml-3 flex-1 rounded bg-gray-700 px-3 py-1 font-mono text-xs text-gray-300">yoursite.com/law</span>
					</div>
					<img src="/images/demo-law-home.webp" alt="Washington Law demo site homepage" class="block w-full" />
				</div>
				<div class="mt-6 text-center">
					<a href={DEMO_URL} class="inline-flex items-center gap-2 font-bold hover:underline" style={`color:${ORANGE}`} set:html={`Explore the full demo site ${ExternalLinkXs}`} />
				</div>
			</div>
		</section>

		<!-- What's Included -->
		<section class="bg-white py-16">
			<div class="mx-auto max-w-5xl px-6">
				<div class="mb-12">
					<p class="mb-3 text-xs font-bold tracking-widest uppercase" style={`color:${ORANGE}`}>What's Included</p>
					<h2 class="max-w-2xl text-3xl leading-snug md:text-4xl" style={`font-family: var(--font-serif); color:${NAVY}`}>A complete marketing system, purpose-built for legal.</h2>
				</div>
				<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-2">
					{included.map((item) => (
						<div class="flex gap-4 rounded-lg border border-gray-200 p-6 transition-all hover:shadow-md" style="border-color: #e5e7eb;">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg" style={`background-color:${ORANGE}1a`}>
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={ORANGE} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
							</div>
							<div>
								<p class="mb-1.5 text-base font-bold" style={`color:${NAVY}`}>{item.label}</p>
								<p class="text-sm leading-relaxed text-gray-500">{item.desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- AI-Powered -->
		<section class="py-16" style={`background-color:${NAVY}`}>
			<div class="mx-auto max-w-5xl px-6">
				<div class="grid items-center gap-12 md:grid-cols-2">
					<div>
						<div class="mb-5 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-bold tracking-widest uppercase" style={`background-color:${ORANGE}33; border-color:${ORANGE}66; color:#f0a080`}>
							AI-Powered
						</div>
						<h2 class="mb-4 text-3xl leading-snug text-white md:text-4xl" style="font-family: var(--font-serif);">An AI assistant that works for your firm 24/7.</h2>
						<p class="mb-4 text-base leading-relaxed text-white/60">Every Ascend legal site includes a live AI chat assistant trained on your firm's content. It answers visitor questions in real time — practice area explanations, process questions, eligibility queries — and captures leads even when your team isn't available.</p>
						<p class="mb-6 text-base leading-relaxed text-white/60">The chat widget is visible on every page of the demo. Try it yourself at the bottom-right of the screen.</p>
						<a href={DEMO_URL} class="inline-flex items-center gap-2 rounded-sm px-6 py-3 font-bold text-white transition-colors" style={`background-color:${ORANGE}`} set:html={`Try the AI Chat on the Demo ${ExternalLinkXs}`} />
					</div>
					<div class="flex flex-col gap-3">
						<div class="space-y-4 rounded-xl border border-white/10 bg-white/5 p-5">
							<div class="mb-4 flex items-center gap-2">
								<div class="flex h-8 w-8 items-center justify-center rounded-full border" style={`background-color:${ORANGE}33; border-color:${ORANGE}4d`}>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ORANGE} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={Bot} />
								</div>
								<div>
									<p class="text-sm leading-none font-bold text-white">Washington Law Assistant</p>
									<p class="text-xs text-green-400">Online now</p>
								</div>
							</div>
							<div class="max-w-xs rounded-lg rounded-tl-none bg-white/10 px-4 py-3 text-sm leading-relaxed text-white/80">Hi! I'm here to answer any questions about our practice areas or how we can help. What brings you here today?</div>
							<div class="ml-auto max-w-xs self-end rounded-lg rounded-tr-none border px-4 py-3 text-sm leading-relaxed text-white/80" style={`background-color:${ORANGE}33; border-color:${ORANGE}33`}>What types of business law cases do you handle?</div>
							<div class="max-w-xs rounded-lg rounded-tl-none bg-white/10 px-4 py-3 text-sm leading-relaxed text-white/80">We handle a broad range of business law matters — contracts, entity formation, partnership disputes, and M&A transactions. Would you like to schedule a free consultation?</div>
						</div>
						<p class="text-center text-xs text-white/35">This is a preview of the AI assistant on the demo site.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Paid Advertising -->
		<section class="overflow-hidden bg-gray-50 py-16">
			<div class="mx-auto max-w-5xl px-6">
				<div class="grid items-center gap-12 md:grid-cols-2">
					<div class="order-2 min-w-0 md:order-1">
						<div class="overflow-hidden rounded-xl border border-gray-200 shadow-xl">
							<div class="flex min-w-0 items-center gap-2 bg-gray-800 px-4 py-2.5">
								<span class="h-2.5 w-2.5 shrink-0 rounded-full bg-red-400/70"></span>
								<span class="h-2.5 w-2.5 shrink-0 rounded-full bg-yellow-400/70"></span>
								<span class="h-2.5 w-2.5 shrink-0 rounded-full bg-green-400/70"></span>
								<span class="ml-2 min-w-0 flex-1 truncate rounded bg-gray-700 px-2 py-0.5 font-mono text-xs text-gray-300">yoursite.com/law/demo/landing-pages</span>
							</div>
							<img src="/images/demo-law-landing-pages.png" alt="Washington Law paid ad landing pages" class="block w-full" />
						</div>
					</div>
					<div class="order-1 min-w-0 md:order-2">
						<p class="mb-3 text-xs font-bold tracking-widest uppercase" style={`color:${ORANGE}`}>Paid Advertising</p>
						<h2 class="mb-4 text-2xl leading-snug md:text-4xl" style={`font-family: var(--font-serif); color:${NAVY}`}>Google Ads + Meta Ads, with landing pages built to convert.</h2>
						<p class="mb-4 leading-relaxed text-gray-600">Ascend builds end-to-end paid ad campaigns for legal firms — from the ad creative itself through to dedicated landing pages engineered for one outcome: a consultation booked.</p>
						<p class="mb-6 leading-relaxed text-gray-600">The demo includes four purpose-built landing pages, each targeting a distinct practice area and audience segment. No navigation. No distractions. Above-the-fold forms. Copy tailored to the exact search intent that triggered the ad.</p>
						<div class="mb-4 space-y-2 rounded-lg border border-gray-200 bg-white p-4">
							{landingPages.map((t) => (
								<div class="flex items-start gap-2 text-sm text-gray-700">
									<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style={`background-color:${ORANGE}`}></span>
									<span>{t}</span>
								</div>
							))}
						</div>
						<div class="mb-6 flex items-start gap-3 rounded-lg border border-gray-200 bg-gray-100 px-4 py-3">
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={ORANGE} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" set:html={ExternalLink.match(/<path.*<\/path>/s)?.[0]} />
							<p class="min-w-0 text-sm leading-relaxed text-gray-600">
								All four landing pages are assembled in one place on the demo site so you can review them side by side.{" "}
								<a href={LANDING_PAGES_URL} class="font-semibold hover:underline" style={`color:${ORANGE}`}>View the full showcase →</a>
							</p>
						</div>
						<a href={LANDING_PAGES_URL} class="flex items-center justify-center gap-2 rounded-sm px-6 py-3 font-bold text-white transition-colors sm:inline-flex" style={`background-color:${NAVY}`} set:html={`View All Four Landing Pages ${ExternalLinkXs}`} />
					</div>
				</div>
			</div>
		</section>

		<!-- Inside the Demo -->
		<section class="border-t border-gray-100 bg-white py-16">
			<div class="mx-auto max-w-5xl px-6">
				<div class="mb-10 text-center">
					<p class="mb-3 text-xs font-bold tracking-widest uppercase" style={`color:${ORANGE}`}>Inside the Demo</p>
					<h2 class="text-3xl" style={`font-family: var(--font-serif); color:${NAVY}`}>Content, team pages, and more.</h2>
					<p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-gray-500">Every page on the demo site represents a real deliverable — content strategy, attorney bios, thought leadership articles, and practice area pages all included.</p>
				</div>
				<div class="grid gap-6 sm:grid-cols-2">
					<div class="overflow-hidden rounded-xl border border-gray-200 shadow-lg">
						<div class="flex items-center gap-1.5 bg-gray-800 px-3 py-2">
							<span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-green-400/70"></span>
							<span class="ml-2 font-mono text-xs text-gray-400">Insights / Content</span>
						</div>
						<img src="/images/demo-law-insights.webp" alt="Washington Law insights and content pages" class="block w-full" />
						<div class="border-t border-gray-100 bg-gray-50 p-4">
							<p class="mb-1 text-sm font-bold" style={`color:${NAVY}`}>Thought Leadership Content</p>
							<p class="text-xs leading-relaxed text-gray-500">Practice area articles written to rank and educate — driving organic traffic and positioning the firm as a trusted authority.</p>
						</div>
					</div>
					<div class="overflow-hidden rounded-xl border border-gray-200 shadow-lg">
						<div class="flex items-center gap-1.5 bg-gray-800 px-3 py-2">
							<span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-green-400/70"></span>
							<span class="ml-2 font-mono text-xs text-gray-400">Our Team</span>
						</div>
						<img src="/images/demo-law-team.webp" alt="Washington Law team page" class="block w-full" />
						<div class="border-t border-gray-100 bg-gray-50 p-4">
							<p class="mb-1 text-sm font-bold" style={`color:${NAVY}`}>Attorney Profiles & Team Pages</p>
							<p class="text-xs leading-relaxed text-gray-500">Individual attorney bios that build trust, showcase credentials, and humanize the firm for prospective clients.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="py-20" style={`background-color:${NAVY}`}>
			<div class="mx-auto max-w-3xl px-6 text-center">
				<p class="mb-4 text-xs font-bold tracking-widest uppercase" style={`color:${ORANGE}`}>Ready to Get Started?</p>
				<h2 class="mb-5 text-3xl leading-snug text-white md:text-4xl" style="font-family: var(--font-serif);">Let's build this for your firm — or someone you know.</h2>
				<p class="mx-auto mb-10 max-w-xl text-base leading-relaxed text-white/55">ProVisors members and their referrals receive 20% off all Ascend Consulting services. Reach out to schedule a free conversation or contact Brad directly.</p>
				<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
					<a href={site.booking} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-bold text-white transition-colors" style={`background-color:${ORANGE}`} set:html={`${CalendarLg} Schedule a Free Consultation`} />
					<a href="/#contact" class="inline-flex items-center gap-2 rounded-sm border border-white/25 px-7 py-3.5 font-semibold text-white/70 transition-colors hover:border-white/50 hover:text-white" set:html={`${Mail} Contact Ascend`} />
				</div>
			</div>
		</section>

		<footer class="py-6" style="background-color: #060e1c;">
			<div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-6 text-sm text-white/35 sm:flex-row">
				<a href="/" class="transition-colors hover:text-white/60">Ascend Consulting</a>
				<div class="flex items-center gap-4">
					<a href="/provisors" class="transition-colors hover:text-white/60">ProVisors</a>
					<a href="mailto:brad@ascendsmartly.com" class="transition-colors hover:text-white/60">brad@ascendsmartly.com</a>
				</div>
			</div>
