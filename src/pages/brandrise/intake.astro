---
import Layout from "../../layouts/Layout.astro";

const ArrowLeft = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>`;

const channelOptions = [
	"Website",
	"Instagram",
	"Facebook",
	"LinkedIn",
	"TikTok / YouTube",
	"Email newsletters",
	"Google Ads / Paid search",
	"Events or trade shows",
	"Word of mouth / referrals",
	"Print or direct mail",
	"Other",
];
const operatingLengthOptions = ["Just getting started", "Under 1 year", "1–3 years", "3–10 years", "10+ years"];
const brandStateOptions = [
	"Fully developed — logo, color palette, typography, messaging, tone of voice, and brand guidelines",
	"Mostly visual — we have a logo and some visual elements, but no defined messaging or verbal identity",
	"Logo only — we have a mark but no broader identity system or guidelines",
	"Scattered and inconsistent — elements exist but nothing is unified or documented",
	"Starting from scratch — we need to build the full identity from the ground up",
];
const deadlineOptions = ["Yes — I have a date in mind", "Sort of — there's a rough timeframe but nothing hard", "No hard deadline"];
const budgetOptions = ["Under $5,000", "$5,000 – $10,000", "$10,000 – $20,000", "$20,000 – $40,000", "$40,000+", "Not sure yet"];

const sections = [
	{
		number: "1",
		title: "Your Contact Details",
		subtitle: "So we know who we're talking to and can follow up if needed.",
		fields: [
			{ type: "text", label: "Full name", required: true, placeholder: "Jane Smith" },
			{ type: "text", label: "Organization or business name", required: true, placeholder: "Acme Co." },
			{ type: "email", label: "Email address", required: true, placeholder: "jane@example.com" },
			{ type: "tel", label: "Phone number", required: true, placeholder: "+1 (555) 000-0000" },
			{ type: "url", label: "Website", labelNote: "(if you have one)", placeholder: "https://example.com" },
			{ type: "text", label: "City & State / Country", placeholder: "Seattle, WA" },
		],
	},
	{
		number: "2",
		title: "Your Goals",
		subtitle: "Think about what you're hoping to walk away with — not the tactics, but the outcomes.",
		fields: [
			{
				type: "textarea",
				label: "What are the top 1–2 things you want to accomplish in the next 12 months?",
				required: true,
				placeholder: "e.g. Generate more leads through our website, launch a rebrand before our annual conference, get our name out in a new market...",
			},
			{
				type: "textarea",
				label: "Where do you want this organization to be in 3–5 years?",
				rows: 3,
				placeholder: "e.g. Become the go-to provider in our region, expand to two new cities, reach $2M in revenue...",
			},
			{
				type: "textarea",
				label: "What would a win look like if you hired Ascend to do this work?",
				rows: 3,
				help: "Think beyond deliverables — what would feel different? What problem would finally be solved?",
				placeholder: "e.g. We'd finally have a brand we're proud to put in front of anyone. Our website would actually bring in leads. The team would be aligned on how to talk about us...",
			},
		],
	},
	{
		number: "3",
		title: "Your Organization",
		subtitle: "Help us get a feel for who you are and what you're building.",
		fields: [
			{
				type: "textarea",
				label: "How would you describe what your organization does — in your own words, like you're explaining it to a friend?",
				placeholder: "e.g. We help small restaurants manage their social media so they can focus on cooking, not content...",
			},
			{ type: "select", label: "How long have you been operating?", options: operatingLengthOptions, selectPlaceholder: "Select one..." },
		],
	},
	{
		number: "4",
		title: "Your Brand Today",
		subtitle: "No judgment — wherever you are is a fine starting point.",
		fields: [
			{
				type: "radio",
				name: "brandAssets",
				label: "How would you describe the current state of your brand identity?",
				options: brandStateOptions,
				help: "A complete brand includes visual identity (logo, colors, typography), verbal identity (messaging, tone of voice, tagline), and guidelines that keep everything consistent across every touchpoint.",
			},
			{
				type: "textarea",
				label: "How would you describe your brand's personality? If your brand were a person, how would they come across?",
				rows: 3,
				help: "Think about tone, values, how you want people to feel after interacting with you.",
				placeholder: "e.g. Warm and approachable, but authoritative — like a trusted advisor, not a salesperson...",
			},
			{
				type: "textarea",
				label: "Is there anything about your current brand you're proud of and want to keep?",
				rows: 3,
				placeholder: "e.g. Our logo has strong recognition in our community. We love our tagline. Our color palette feels right...",
			},
			{
				type: "textarea",
				label: "List up to five brands you admire and aspire to be like.",
				rows: 4,
				help: "These don't need to be in your industry — just brands whose look, feel, or personality resonates with you. A sentence on why helps too.",
				placeholder: "e.g. 1. Patagonia — values-driven, no-nonsense 2. Mailchimp — friendly and human 3. Apple — clean and premium...",
			},
		],
	},
	{
		number: "5",
		title: "Marketing & Visibility",
		subtitle: "Where you show up today and what's actually working (or not).",
		fields: [
			{ type: "checkboxes", label: "Where does your organization currently show up?", labelNote: "(check all that apply)", options: channelOptions },
			{
				type: "textarea",
				label: "What's been working well with your marketing, even if just a little?",
				rows: 3,
				placeholder: "e.g. Our Instagram gets good engagement. Word of mouth has been strong. Our email open rates are solid...",
			},
			{
				type: "textarea",
				label: "What's clearly not working — or what feels like a gap?",
				rows: 3,
				placeholder: "e.g. We have no consistent presence online. Our website doesn't convert. We've never had a real strategy...",
			},
		],
	},
	{
		number: "6",
		title: "Your Customers",
		subtitle: "Understanding who you serve helps us understand your entire business.",
		fields: [
			{
				type: "textarea",
				label: "Describe your ideal customer or client as if they were a real person — who are they, what do they care about, what keeps them up at night?",
				placeholder:
					"e.g. Small business owners in their 40s who are great at their craft but overwhelmed by everything that comes with running a business. They care about reputation and don't have time to waste...",
			},
			{
				type: "textarea",
				label: "What problem do you solve for them that they can't easily get elsewhere?",
				rows: 3,
				placeholder: "e.g. We combine strategy and execution under one roof — clients don't have to manage multiple vendors...",
			},
		],
	},
	{
		number: "7",
		title: "The Competitive Landscape",
		subtitle: "You don't need a full market analysis — just your honest read on the field.",
		fields: [
			{
				type: "textarea",
				label: "Who are your main competitors, and how are you different from them?",
				placeholder: "e.g. Our main competitors are XYZ and ABC. We're different because we specialize in nonprofits and they serve everyone...",
			},
			{
				type: "textarea",
				label: "What do your best customers say about why they chose you over someone else?",
				rows: 3,
				placeholder: "e.g. They say we feel more personal. We actually listen. We don't oversell...",
			},
		],
	},
	{
		number: "8",
		title: "Timeline & What Success Looks Like",
		subtitle: "Helps us understand urgency and set realistic expectations.",
		fields: [
			{
				type: "textarea",
				label: "What would a wildly successful outcome look like 12 months from now?",
				placeholder:
					"e.g. Our website is generating consistent leads. We have a brand we're proud to show anyone. Our team knows exactly how to talk about us...",
			},
			{
				type: "radio",
				name: "hasDeadline",
				label: "Do you have a specific deadline, launch date, or event you're working toward?",
				options: deadlineOptions,
				conditional: {
					value: deadlineOptions[0],
					field: { label: "What's the date or event?", placeholder: "e.g. Annual conference on October 12, annual board meeting in March..." },
				},
			},
		],
	},
	{
		number: "9",
		title: "Team & Budget",
		subtitle: "No pressure on exact numbers — a ballpark helps us recommend the right scope.",
		fields: [
			{
				type: "textarea",
				label: "Who's currently involved in your marketing — do you have a dedicated team, or is it mostly you?",
				rows: 3,
				placeholder: "e.g. It's mostly me with help from a part-time assistant. We have a marketing director but no agency yet. Our team of 3 splits it...",
			},
			{
				type: "select",
				label: "What's your approximate budget range for this kind of work?",
				options: budgetOptions,
				selectPlaceholder: "Select a range...",
				help: "This helps us match you with the right tier — no commitment implied.",
			},
		],
	},
	{
		number: "10",
		title: "Anything Else?",
		subtitle: "This is the stuff that's easy to miss but often the most important to know upfront.",
		fields: [
			{
				type: "textarea",
				label: "Is there anything about your brand or organization that's off-limits or that you're nervous about changing?",
				rows: 3,
				placeholder: "e.g. Our founder's name is closely tied to the brand. We have stakeholders who are attached to certain visual elements. We've had bad experiences with rebranding before...",
			},
			{
				type: "textarea",
				label: "Anything else you'd like us to know before your call?",
				rows: 3,
				placeholder: "Open floor — share whatever's on your mind.",
			},
		],
	},
];
---

<Layout
	title="BrandRise™ Pre-Call Intake | Ascend Consulting"
	description="Complete your BrandRise™ pre-call intake form so the Ascend team can review your goals, brand, and context before your exploratory call."
	bare
	noindex
>
	<div class="min-h-screen bg-gray-50">
		<div class="bg-primary px-6 py-10">
			<div class="mx-auto max-w-2xl">
				<a href="/brandrise" class="mb-5 inline-flex items-center gap-1.5 text-sm text-white/60 transition-colors hover:text-white" set:html={`${ArrowLeft} Back to BrandRise™`} />
				<p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">Pre-Call Intake Form</p>
				<h1 class="mb-3 text-3xl leading-snug text-white md:text-4xl">Help Ascend prepare for your call.</h1>
				<p class="text-base leading-relaxed text-white/65">
					Answer as much or as little as you're comfortable with — there are no wrong answers. The more context
					you share, the more productive your exploratory call will be. It typically takes 15–20 minutes.
				</p>
			</div>
		</div>

		<form id="intake-form" class="mx-auto max-w-2xl space-y-8 px-6 py-12">
			<!-- Honeypot: hidden from real visitors, bots that fill every field trip it. -->
			<input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] h-0 w-0 opacity-0" aria-hidden="true" />
			{
				sections.map((section) => (
					<div class="space-y-6 rounded-sm border border-gray-200 bg-white p-7 shadow-sm md:p-9">
						<div class="mb-6 flex items-start gap-4">
							<div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">{section.number}</div>
							<div>
								<h2 class="text-lg leading-snug font-semibold text-primary">{section.title}</h2>
								<p class="mt-0.5 text-sm leading-relaxed text-gray-500">{section.subtitle}</p>
							</div>
						</div>
						{section.fields.map((field) => (
							<>
								<div class="intake-field" data-label={field.label}>
									<label class="mb-1.5 block text-sm font-semibold text-primary">
										{field.label}
										{field.labelNote && <span class="ml-1 font-normal text-gray-400">{field.labelNote}</span>}
										{field.required && <span class="ml-1 text-accent">*</span>}
									</label>
									{field.help && <p class="mb-2 text-xs leading-relaxed text-gray-400">{field.help}</p>}
									{(field.type === "text" || field.type === "email" || field.type === "tel" || field.type === "url") && (
										<input
											type={field.type}
											required={field.required}
											placeholder={field.placeholder}
											class="w-full rounded-sm border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-800 transition-colors placeholder-gray-300 focus:border-accent/50 focus:ring-2 focus:ring-accent/30 focus:outline-none"
										/>
									)}
									{field.type === "textarea" && (
										<textarea
											rows={field.rows ?? 4}
											required={field.required}
											placeholder={field.placeholder}
											class="w-full resize-y rounded-sm border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-800 transition-colors placeholder-gray-300 focus:border-accent/50 focus:ring-2 focus:ring-accent/30 focus:outline-none"
										/>
									)}
									{field.type === "select" && (
										<select class="w-full rounded-sm border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-800 transition-colors focus:border-accent/50 focus:ring-2 focus:ring-accent/30 focus:outline-none">
											<option value="">{field.selectPlaceholder ?? "Select one..."}</option>
											{field.options?.map((opt) => <option value={opt}>{opt}</option>)}
										</select>
									)}
									{field.type === "checkboxes" && (
										<div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
											{field.options?.map((opt) => (
												<label class="flex items-center gap-2 text-sm text-gray-700">
													<input type="checkbox" value={opt} class="h-4 w-4 rounded border-gray-300 text-accent focus:ring-accent/30" />
													{opt}
												</label>
											))}
										</div>
									)}
									{field.type === "radio" && (
										<div class="mt-1 space-y-2">
											{field.options?.map((opt) => (
												<label class="flex items-center gap-3 text-sm text-gray-700">
													<input type="radio" name={field.name} value={opt} class="h-4 w-4 border-gray-300 text-accent focus:ring-accent/30" />
													{opt}
												</label>
											))}
										</div>
									)}
								</div>
								{field.conditional && (
									<div
										class="intake-field intake-conditional hidden"
										data-label={field.conditional.field.label}
										data-conditional-for={field.name}
										data-conditional-value={field.conditional.value}
									>
										<label class="mb-1.5 block text-sm font-semibold text-primary">{field.conditional.field.label}</label>
										<input
											type="text"
											placeholder={field.conditional.field.placeholder}
											class="w-full rounded-sm border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-800 transition-colors placeholder-gray-300 focus:border-accent/50 focus:ring-2 focus:ring-accent/30 focus:outline-none"
										/>
									</div>
								)}
							</>
						))}
					</div>
				))
			}

			<div class="rounded-sm border border-gray-200 bg-white p-7 text-center shadow-sm md:p-9">
				<div id="intake-idle">
					<h2 class="mb-2 text-lg font-semibold text-primary">Ready to send?</h2>
					<p class="mb-6 text-sm leading-relaxed text-gray-500">
						Clicking the button below sends your answers to Ascend. We'll review everything before your call.
					</p>
					<button
						type="submit"
						id="intake-submit"
						class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-accent px-8 py-4 text-lg font-medium text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-xl disabled:pointer-events-none disabled:opacity-60 sm:w-auto"
					>
						Send My Intake
					</button>
					<p id="intake-error" class="mt-4 hidden text-sm font-medium text-red-600"></p>
				</div>
				<div id="intake-success" class="hidden">
					<h2 class="mb-2 text-lg font-semibold text-primary">Thanks — we've got it.</h2>
					<p class="text-sm leading-relaxed text-gray-500">Your intake was sent to Ascend. We'll review it before your call.</p>
				</div>
			</div>
		</form>

		<script>
			import { getRecaptchaToken } from "../../lib/recaptchaClient";

			const form = document.getElementById("intake-form") as HTMLFormElement;
			const submitBtn = document.getElementById("intake-submit") as HTMLButtonElement;
			const errorEl = document.getElementById("intake-error") as HTMLParagraphElement;
			const idleEl = document.getElementById("intake-idle") as HTMLDivElement;
			const successEl = document.getElementById("intake-success") as HTMLDivElement;

			// Toggle conditional follow-up fields (e.g. the "What's the date or event?" field)
			// based on the selected value of their controlling radio group.
			form?.querySelectorAll<HTMLElement>("[data-conditional-for]").forEach((wrapper) => {
				const name = wrapper.dataset.conditionalFor;
				const targetValue = wrapper.dataset.conditionalValue;
				if (!name) return;
				const radios = form.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`);
				const update = () => {
					const checked = Array.from(radios).find((r) => r.checked);
					wrapper.classList.toggle("hidden", !(checked && checked.value === targetValue));
				};
				radios.forEach((r) => r.addEventListener("change", update));
				update();
			});

			form?.addEventListener("submit", async (e) => {
				e.preventDefault();
				if (!form.reportValidity()) return;

				errorEl.classList.add("hidden");
				submitBtn.disabled = true;
				submitBtn.textContent = "Sending...";

				const fields: { label: string; value: string }[] = [];
				form.querySelectorAll<HTMLElement>(".intake-field").forEach((wrapper) => {
					const label = wrapper.dataset.label ?? "";
					const checkboxes = wrapper.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
					if (checkboxes.length) {
						const checked = Array.from(checkboxes)
							.filter((c) => c.checked)
							.map((c) => c.value);
						fields.push({ label, value: checked.join(", ") });
						return;
					}
					const radios = wrapper.querySelectorAll<HTMLInputElement>('input[type="radio"]');
					if (radios.length) {
						const checked = Array.from(radios).find((r) => r.checked);
						fields.push({ label, value: checked?.value ?? "" });
						return;
					}
					const input = wrapper.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select");
					if (input) fields.push({ label, value: input.value });
				});

				const website = (form.querySelector('input[name="website"]') as HTMLInputElement)?.value ?? "";

				try {
					const recaptchaToken = await getRecaptchaToken("brandrise_intake");
					const res = await fetch("/api/brandrise-intake", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ fields, website, recaptchaToken }),
					});
					if (!res.ok) {
						const data = await res.json().catch(() => ({}));
						throw new Error(data.error || "Something went wrong, please try again.");
					}
					idleEl.classList.add("hidden");
					successEl.classList.remove("hidden");
					window.scrollTo({ top: form.offsetTop, behavior: "smooth" });
				} catch (err) {
					errorEl.textContent = err instanceof Error ? err.message : "Something went wrong, please try again.";
					errorEl.classList.remove("hidden");
					submitBtn.disabled = false;
					submitBtn.textContent = "Send My Intake";
				}
			});
		</script>
	</div>
</Layout>
