---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import DeferredChatWidget from "../components/DeferredChatWidget.tsx";
import { site, canonicalUrl } from "../data/site";
import { services } from "../data/services";

interface Props {
	title: string;
	description: string;
	transparentHeader?: boolean;
	/** Skip the site Nav and Footer — used by standalone pages like Terms, or pages with their own custom header/footer. */
	bare?: boolean;
	/** Skip the default Ava chat widget — used by sub-sites (e.g. /law, /finance) that inject their own themed chat widget instead. */
	hideChat?: boolean;
	noindex?: boolean;
	canonical?: string;
	/** Absolute or root-relative image URL for og:image/twitter:image. Defaults to the site's social share image. */
	ogImage?: string;
	ogType?: "website" | "article";
	/** schema.org type of the page itself; defaults to a generic WebPage. */
	pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage" | "ProfilePage";
	/** Breadcrumb trail after "Home". Defaults to a single crumb for the current page. */
	breadcrumbs?: { name: string; url: string }[];
	/** ISO date the page content was last meaningfully updated (shown to search and AI engines). */
	dateModified?: string;
}

const {
	title,
	description,
	transparentHeader = false,
	bare = false,
	hideChat = false,
	noindex = false,
	canonical,
	ogImage = "/images/opengraph.jpg",
	ogType = "website",
	pageType = "WebPage",
	breadcrumbs,
	dateModified,
} = Astro.props;

// Self-referencing canonical, driven by the configured `site` + the current URL, unless
// a page explicitly overrides it (e.g. a dynamic route resolving to a different canonical
// target). This guarantees every page — including future ones — canonicalizes to the
// correct www domain by default instead of needing a hardcoded prop per page.
const resolvedCanonical = canonicalUrl(canonical ?? Astro.url.pathname);
const resolvedOgImage = new URL(ogImage, site.url).href;

// Sitewide entity graph: the organization (ProfessionalService + LocalBusiness), its founder
// (Person), the WebSite, and a WebPage node for the current page that ties them together with
// the breadcrumb trail. Skipped on noindexed pages (demo microsites, private areas, legal
// boilerplate) so schema never claims to describe a page it isn't actually about.
const orgId = `${site.url}/#organization`;
const personId = `${site.url}/#brad-stave`;
const websiteId = `${site.url}/#website`;
const pageId = `${resolvedCanonical}#webpage`;
const isHomepage = Astro.url.pathname === "/";

// Trail after "Home". Pages with real hierarchy (services, case studies, articles) pass their own.
const trail = breadcrumbs ?? [{ name: title.split(" | ")[0], url: resolvedCanonical }];
const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	"@id": `${resolvedCanonical}#breadcrumb`,
	itemListElement: [{ name: "Home", url: `${site.url}/` }, ...trail].map((crumb, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: crumb.name,
		item: crumb.url.includes("#") ? new URL(crumb.url, site.url).href : canonicalUrl(crumb.url),
	})),
};

const topics = [
	"Marketing strategy",
	"Growth marketing",
	"Brand development",
	"Brand strategy",
	"Sales enablement",
	"Lifecycle marketing",
	"Digital acquisition",
	"Podcast production",
	"SEO, GEO and AEO",
	"AI-powered marketing systems",
	"Nonprofit marketing",
];

const entityGraph = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": ["ProfessionalService", "LocalBusiness"],
			"@id": orgId,
			name: site.name,
			url: `${site.url}/`,
			logo: { "@type": "ImageObject", url: `${site.url}/images/ascend-logo-color.webp` },
			image: resolvedOgImage,
			description:
				"Ascend Consulting is a strategic marketing and growth consultancy founded by Brad Stave. We help nonprofits, technology companies, and growth-stage businesses rise with purpose through brand development, growth marketing, AI-powered marketing systems, lifecycle marketing, sales enablement, and creative design — optimized for SEO, GEO, and AEO.",
			founder: { "@id": personId },
			address: { "@type": "PostalAddress", addressLocality: "Tacoma", addressRegion: "WA", addressCountry: "US" },
			contactPoint: {
				"@type": "ContactPoint",
				telephone: site.phone,
				email: site.email,
				contactType: "customer service",
				availableLanguage: "English",
			},
			areaServed: "Worldwide",
			knowsAbout: topics,
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: "Ascend Consulting services",
				itemListElement: services.map((svc) => ({
					"@type": "Offer",
					itemOffered: { "@type": "Service", name: svc.name, url: canonicalUrl(`/services/${svc.slug}`) },
				})),
			},
			sameAs: site.sameAs,
		},
		{
			"@type": "Person",
			"@id": personId,
			name: "Brad Stave",
			url: canonicalUrl("/about"),
			jobTitle: "Founder & Principal Consultant",
			worksFor: { "@id": orgId },
			email: site.email,
			telephone: site.phone,
			knowsAbout: topics,
			description:
				"Brad Stave is a senior marketing executive with 20+ years of global leadership experience across nonprofit, technology, and real estate sectors, including senior roles at Water Mission, VisionFund International, and Zones, LLC. He is the Founder of Ascend Consulting and a partner at Ninestone Partners, and hosts The Wide Lens Podcast.",
			sameAs: site.sameAs,
		},
		{
			"@type": "WebSite",
			"@id": websiteId,
			url: `${site.url}/`,
			name: site.name,
			inLanguage: "en-US",
			publisher: { "@id": orgId },
		},
		{
			"@type": pageType,
			"@id": pageId,
			url: resolvedCanonical,
			name: title,
			description,
			inLanguage: "en-US",
			isPartOf: { "@id": websiteId },
			about: { "@id": orgId },
			primaryImageOfPage: { "@type": "ImageObject", url: resolvedOgImage },
			...(dateModified ? { dateModified } : {}),
			...(isHomepage ? {} : { breadcrumb: { "@id": breadcrumbSchema["@id"] } }),
		},
		...(isHomepage ? [] : [breadcrumbSchema]),
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/images/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={site.themeColor} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			noindex ? (
				<meta name="robots" content="noindex, nofollow" />
			) : (
				<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
			)
		}
		<link rel="canonical" href={resolvedCanonical} />

		<link rel="alternate" type="application/rss+xml" title={`${site.name} Insights`} href="/rss.xml" />
		<link rel="alternate" type="text/plain" title="LLM-readable summary of this site" href="/llms.txt" />

		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:url" content={resolvedCanonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="720" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />

		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />}
	</head>
	<body class="bg-white text-foreground">
		{!bare && <Nav transparent={transparentHeader} />}
		<main>
			<slot />
		</main>
		{!bare && <Footer />}
		{!hideChat && <DeferredChatWidget client:idle />}

		<script>
			// Site-wide smooth scroll: applies to every page (main site, /law, /finance, and
			// all their landing pages), regardless of which header/nav markup that page uses.
			// Individual components (e.g. Nav.astro's data-scroll-to buttons) that already
			// implement their own smooth scroll call preventDefault(), so this delegated
			// handler backs off for those via the e.defaultPrevented check below.
			document.addEventListener("click", (e) => {
				if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				const link = (e.target as HTMLElement).closest("a[href]");
				if (!link) return;
				const href = link.getAttribute("href");
				if (!href) return;

				// Same-page anchor link (e.g. href="#faq"): smooth-scroll to the target,
				// offset for whatever fixed/sticky header this page has (if any).
				if (href.startsWith("#") && href.length > 1) {
					const target = document.getElementById(href.slice(1));
					if (!target) return;
					e.preventDefault();
					const header = document.querySelector("header.fixed, header.sticky") as HTMLElement | null;
					const offset = (header?.offsetHeight ?? 0) + 12;
					const top = target.getBoundingClientRect().top + window.scrollY - offset;
					window.scrollTo({ top, behavior: "smooth" });
					return;
				}

				// Logo / nav link pointing back to the exact page already open (e.g. clicking
				// the logo while already home): scroll to top smoothly instead of reloading.
				let url: URL;
				try {
					url = new URL(href, window.location.href);
				} catch {
					return;
				}
				if (url.origin === window.location.origin && url.pathname === window.location.pathname && !url.hash && !url.search) {
					e.preventDefault();
					window.scrollTo({ top: 0, behavior: "smooth" });
				}
			});
		</script>
	</body>
</html>
