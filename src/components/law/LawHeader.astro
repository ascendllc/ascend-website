---
import LawLogo from "./LawLogo.astro";

const isHome = Astro.url.pathname === "/law" || Astro.url.pathname === "/law/";

const practiceAreas = [
	{ id: "business-corporate", slug: "business-corporate-law", title: "Business & Corporate Law" },
	{ id: "estate-planning", slug: "estate-planning-trusts", title: "Estate Planning" },
	{ id: "employment", slug: "employment-law", title: "Employment Law" },
	{ id: "real-estate", slug: "real-estate-law", title: "Real Estate Law" },
	{ id: "civil-litigation", slug: "civil-litigation", title: "Civil Litigation" },
];

const ChevronDown = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>`;
const Menu = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg>`;
const X = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>`;
---

<header
	id="law-header"
	class:list={["fixed top-0 z-50 w-full py-6 transition-all duration-300", isHome ? "law-header-home bg-transparent" : "bg-white py-4 shadow-sm"]}
>
	<div class="container mx-auto flex max-w-7xl items-center justify-between px-6">
		<LawLogo light={isHome} />

		<div class="hidden items-center gap-8 lg:flex">
			<div class="relative law-dropdown">
				<button
					type="button"
					class:list={["law-nav-link flex items-center gap-1", isHome ? "text-white" : "text-[#162140]"]}
					data-dropdown-trigger="practice"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Practice Areas
					<span class="h-4 w-4 transition-transform duration-200 law-chevron" set:html={ChevronDown} />
				</button>
				<div class="absolute top-full left-0 pt-6 opacity-0 invisible pointer-events-none transition-all duration-200 law-dropdown-panel" data-dropdown-panel="practice">
					<div class="flex w-[600px] flex-col gap-4 rounded-md border border-gray-100 bg-white p-6 shadow-xl">
						<div class="grid grid-cols-2 gap-4">
							{practiceAreas.map((p) => (
								<a href={`/law/practice-areas/${p.slug}`} class="group/item block">
									<span class="font-display block text-lg font-semibold text-[#162140] transition-colors group-hover/item:text-[#c29129]">{p.title}</span>
								</a>
							))}
						</div>
						<div class="my-2 h-px w-full bg-gray-100"></div>
						<a href="/law/practice-areas" class="text-sm font-semibold tracking-wide text-[#c29129] hover:underline">→ View All Practice Areas</a>
					</div>
				</div>
			</div>
			<a href="/law/our-team" class:list={["law-nav-link", isHome ? "text-white" : "text-[#162140]"]}>Our Team</a>
			<a href="/law/results" class:list={["law-nav-link", isHome ? "text-white" : "text-[#162140]"]}>Results</a>
			<a href="/law/insights" class:list={["law-nav-link", isHome ? "text-white" : "text-[#162140]"]}>Insights</a>
			<div class="relative law-dropdown">
				<button
					type="button"
					class:list={["law-nav-link flex items-center gap-1", isHome ? "text-white" : "text-[#162140]"]}
					data-dropdown-trigger="about"
					aria-haspopup="true"
					aria-expanded="false"
				>
					About
					<span class="h-4 w-4 transition-transform duration-200 law-chevron" set:html={ChevronDown} />
				</button>
				<div class="absolute top-full left-0 pt-6 opacity-0 invisible pointer-events-none transition-all duration-200 law-dropdown-panel" data-dropdown-panel="about">
					<div class="flex min-w-[200px] flex-col rounded-md border border-gray-100 bg-white py-4 shadow-xl">
						<a href="/law/about/our-story" class="px-6 py-2 text-sm font-medium text-[#162140] hover:bg-[#38425c]/10">Our Story</a>
						<a href="/law/about/our-values" class="px-6 py-2 text-sm font-medium text-[#162140] hover:bg-[#38425c]/10">Our Values</a>
						<a href="/law/about/community" class="px-6 py-2 text-sm font-medium text-[#162140] hover:bg-[#38425c]/10">Community</a>
						<div class="mx-4 my-2 h-px bg-gray-100"></div>
						<a href="/law/contact" class="px-6 py-2 text-sm font-medium text-[#162140] hover:bg-[#38425c]/10">Contact Us</a>
					</div>
				</div>
			</div>
		</div>

		<div class="hidden lg:flex">
			<a href="/law/contact" class="rounded-none bg-[#c29129] px-6 py-3 text-xs font-semibold tracking-widest text-white uppercase transition-colors hover:bg-[#c29129]/90">Book a Consultation →</a>
		</div>

		<button type="button" id="law-mobile-toggle" class="p-2 lg:hidden" aria-label="Toggle menu">
			<span class:list={["block h-6 w-6", isHome ? "text-white" : "text-[#162140]"]} id="law-mobile-icon-open" set:html={Menu} />
			<span class="hidden h-6 w-6 text-[#162140]" id="law-mobile-icon-close" set:html={X} />
		</button>
	</div>

	<div id="law-mobile-menu" class="fixed inset-0 z-40 -translate-y-full overflow-y-auto bg-white px-6 pt-24 transition-transform duration-300">
		<div class="flex flex-col gap-6">
			<a href="/law" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">Home</a>
			<a href="/law/practice-areas" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">Practice Areas</a>
			<a href="/law/our-team" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">Our Team</a>
			<a href="/law/results" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">Results</a>
			<a href="/law/insights" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">Insights</a>
			<a href="/law/about" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">About Us</a>
			<a href="/law/contact" class="font-display border-b pb-4 text-xl font-semibold text-[#162140]">Contact</a>
			<div class="mt-8 flex flex-col gap-4">
				<a href="/law/contact" class="w-full rounded-none bg-[#c29129] py-6 text-center text-sm font-semibold tracking-widest text-white uppercase hover:bg-[#c29129]/90">Book a Consultation →</a>
			</div>
		</div>
	</div>
</header>

<style>
	/* Static, state-independent styling only. Anything that depends on a JS-added
	   class (scroll position, open/closed dropdowns, the mobile menu) is handled
	   below by toggling plain Tailwind utility classes directly on the affected
	   elements instead — a scoped selector like `.law-header-home.law-scrolled`
	   only ever matches after user interaction, so the production build's
	   critical-CSS step (which crawls the page in its initial, un-interacted
	   state) silently drops any rule that depends on one. Utility classes don't
	   have this problem because they're already present verbatim elsewhere in
	   the page's markup, so the build always considers them in use. */
	.law-nav-link {
		font-family: var(--law-font-sans, inherit);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: color 0.2s;
	}
	.law-nav-link:hover {
		color: #c29129;
	}
</style>

<script>
	const header = document.getElementById("law-header");
	const isHome = header?.classList.contains("law-header-home");
	const navLinks = header?.querySelectorAll<HTMLElement>(".law-nav-link") ?? [];
	const mobileIconOpen = document.getElementById("law-mobile-icon-open");
	const logoMask = header?.querySelector<HTMLElement>(".law-logo-mask");
	const logoTexts = header?.querySelectorAll<HTMLElement>(".law-logo-text") ?? [];

	function setScrolled(isScrolled: boolean) {
		if (!header) return;
		header.classList.toggle("bg-transparent", !isScrolled);
		header.classList.toggle("bg-white", isScrolled);
		header.classList.toggle("shadow-sm", isScrolled);
		header.classList.toggle("py-6", !isScrolled);
		header.classList.toggle("py-4", isScrolled);

		navLinks.forEach((link) => {
			link.classList.toggle("text-white", !isScrolled);
			link.classList.toggle("text-[#162140]", isScrolled);
		});
		mobileIconOpen?.classList.toggle("text-white", !isScrolled);
		logoTexts.forEach((el) => {
			el.classList.toggle("text-white", !isScrolled);
			el.classList.toggle("text-[#162140]", isScrolled);
		});
		if (logoMask) logoMask.style.backgroundColor = isScrolled ? "#162140" : "#F8F4EE";
	}

	function onScroll() {
		if (!header || !isHome) return;
		setScrolled(window.scrollY > 20);
	}
	window.addEventListener("scroll", onScroll);
	onScroll();

	function closeDropdown(wrapper: Element) {
		const panel = wrapper.querySelector<HTMLElement>("[data-dropdown-panel]");
		const chevron = wrapper.querySelector<HTMLElement>(".law-chevron");
		panel?.classList.add("opacity-0", "invisible", "pointer-events-none");
		panel?.classList.remove("opacity-100", "visible", "pointer-events-auto");
		chevron?.classList.remove("rotate-180");
		wrapper.classList.remove("law-open");
	}
	function openDropdown(wrapper: Element) {
		const panel = wrapper.querySelector<HTMLElement>("[data-dropdown-panel]");
		const chevron = wrapper.querySelector<HTMLElement>(".law-chevron");
		panel?.classList.remove("opacity-0", "invisible", "pointer-events-none");
		panel?.classList.add("opacity-100", "visible", "pointer-events-auto");
		chevron?.classList.add("rotate-180");
		wrapper.classList.add("law-open");
	}
	document.querySelectorAll<HTMLElement>("[data-dropdown-trigger]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const wrapper = btn.closest(".law-dropdown");
			if (!wrapper) return;
			const isOpen = wrapper.classList.contains("law-open");
			document.querySelectorAll(".law-dropdown").forEach((d) => closeDropdown(d));
			if (!isOpen) openDropdown(wrapper);
		});
	});
	document.addEventListener("click", (e) => {
		if (!(e.target as HTMLElement).closest(".law-dropdown")) {
			document.querySelectorAll(".law-dropdown").forEach((d) => closeDropdown(d));
		}
	});

	const mobileToggle = document.getElementById("law-mobile-toggle");
	const mobileMenu = document.getElementById("law-mobile-menu");
	const iconOpen = document.getElementById("law-mobile-icon-open");
	const iconClose = document.getElementById("law-mobile-icon-close");
	mobileToggle?.addEventListener("click", () => {
		const isOpen = mobileMenu?.classList.toggle("law-open");
		mobileMenu?.classList.toggle("-translate-y-full", !isOpen);
		mobileMenu?.classList.toggle("translate-y-0", !!isOpen);
		iconOpen?.classList.toggle("hidden", isOpen);
		iconClose?.classList.toggle("hidden", !isOpen);
	});
</script>
