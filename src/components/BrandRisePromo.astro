---
import BrandRiseWordmark from "./BrandRiseWordmark.astro";

interface Props {
	variant?: "hero" | "split" | "gradient" | "bordered";
}
const { variant = "hero" } = Astro.props;

const ArrowRight = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
---

{
	variant === "hero" && (
		<a
			href="/brandrise"
			aria-label="Explore BrandRise™ launch packages"
			class="group relative block overflow-hidden rounded-sm border border-white/20 bg-white/[0.07] transition-all duration-300 hover:border-white/30 hover:bg-white/[0.11] hover:shadow-[0_0_40px_rgba(255,255,255,0.07)]"
		>
			<div class="h-px w-full bg-gradient-to-r from-transparent via-accent/70 to-transparent" />
			<div class="flex flex-col items-center px-6 py-8 text-center md:px-8 md:py-10">
				<p class="mb-2 text-base font-bold tracking-wide text-white">Introducing:</p>
				<div class="mb-4">
					<p class="text-4xl leading-none tracking-tight font-serif md:text-5xl">
						<BrandRiseWordmark />
					</p>
				</div>
				<p class="mb-6 max-w-lg text-sm leading-relaxed text-white/70 md:text-base">
					Your complete solution for building or relaunching your organization's brand, marketing,
					and promotional presence.
				</p>
				<div class="mb-6 flex items-center justify-center gap-4 text-xs font-bold tracking-wider uppercase">
					<span class="text-white/50">Brand</span>
					<span class="h-1 w-1 rounded-full bg-accent/50" />
					<span class="text-white/50">Marketing</span>
					<span class="h-1 w-1 rounded-full bg-accent/50" />
					<span class="text-white/50">Promotion</span>
				</div>
				<span class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-bold text-white">
					Starting at $250
				</span>
				<span
					class="inline-flex items-center gap-2 rounded-sm border border-accent/30 bg-accent/15 px-5 py-2.5 text-sm font-bold text-accent transition-all group-hover:gap-3 group-hover:border-accent/50 hover:bg-accent/25"
					set:html={`See What's Included in BrandRise™ ${ArrowRight}`}
				/>
			</div>
			<div class="h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent" />
		</a>
	)
}

{
	variant === "split" && (
		<a
			href="/brandrise"
			class="group flex flex-col items-stretch gap-0 overflow-hidden rounded-sm border border-primary/15 shadow-sm transition-all duration-300 hover:shadow-md sm:flex-row"
		>
			<div class="flex w-full shrink-0 flex-col items-center justify-center gap-1 bg-primary px-8 py-6 sm:w-64 sm:items-start">
				<p class="mb-1 text-xs font-bold tracking-widest text-white/50 uppercase">Introducing</p>
				<p class="text-3xl leading-none tracking-tight font-serif">
					<BrandRiseWordmark />
				</p>
			</div>
			<div class="flex-1 border-t border-primary/10 bg-gray-50 px-8 py-6 sm:border-t-0 sm:border-l">
				<p class="mb-1 text-base leading-snug font-semibold text-primary">
					Ready to build or relaunch your organization?
				</p>
				<p class="mb-4 text-sm leading-relaxed text-gray-500">
					BrandRise™ is your complete solution — strategy, identity, website, marketing, and
					promotion in one tiered package. Starting at $250.
				</p>
				<span
					class="inline-flex items-center gap-1.5 text-sm font-bold text-accent transition-all duration-200 group-hover:gap-3"
					set:html={`Explore BrandRise™ Packages ${ArrowRight}`}
				/>
			</div>
		</a>
	)
}

{
	variant === "gradient" && (
		<a
			href="/brandrise"
			class="group relative mt-10 flex flex-col items-center gap-6 overflow-hidden rounded-sm border border-white/10 bg-gradient-to-br from-gray-900 via-primary to-indigo-900 px-8 py-8 shadow-lg transition-all duration-300 hover:border-white/20 hover:shadow-xl md:flex-row md:gap-10 md:px-12 md:py-10"
		>
			<div class="pointer-events-none absolute -top-10 -right-10 h-48 w-48 rounded-full bg-accent/15 blur-3xl" />
			<div class="pointer-events-none absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-indigo-500/10 blur-3xl" />
			<div class="relative z-10 shrink-0 text-center md:text-left">
				<p class="mb-1.5 text-xs font-bold tracking-widest text-white/40 uppercase">New offering</p>
				<p class="text-4xl leading-none tracking-tight font-serif md:text-5xl">
					<BrandRiseWordmark />
				</p>
			</div>
			<div class="relative z-10 hidden h-full w-px self-stretch bg-white/15 md:block" />
			<div class="relative z-10 flex-1 text-center md:text-left">
				<p class="mb-2 text-lg leading-snug font-semibold text-white">
					Build or relaunch your organization — completely.
				</p>
				<p class="mb-5 text-sm leading-relaxed text-white/55">
					Strategy. Identity. Website. Go-to-market. Promotion. Five ways to launch, starting at
					$250.
				</p>
				<span
					class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-2.5 text-sm font-bold text-white shadow-md transition-all group-hover:-translate-y-0.5 hover:bg-accent/90"
					set:html={`Explore BrandRise™ ${ArrowRight}`}
				/>
			</div>
		</a>
	)
}

{
	variant === "bordered" && (
		<a
			href="/brandrise"
			class="group flex flex-col items-stretch gap-0 overflow-hidden rounded-sm border border-white/15 bg-white/5 transition-all duration-300 hover:border-accent/40 hover:bg-white/8 sm:flex-row"
		>
			<div class="relative flex w-full shrink-0 flex-col items-center justify-center overflow-hidden px-7 py-6 sm:w-56 sm:items-start">
				<div class="absolute top-0 left-0 h-full w-1 bg-gradient-to-b from-accent via-orange-300 to-yellow-300" />
				<p class="mb-2 pl-2 text-xs font-bold tracking-widest text-white/35 uppercase">New Offering</p>
				<p class="pl-2 text-3xl leading-none tracking-tight font-serif">
					<BrandRiseWordmark />
				</p>
			</div>
			<div class="hidden w-px self-stretch bg-white/10 sm:block" />
			<div class="flex flex-1 flex-col items-center justify-between gap-5 px-7 py-6 sm:flex-row">
				<div>
					<p class="mb-1 text-base leading-snug font-semibold text-white">
						Build or relaunch your organization — completely.
					</p>
					<p class="text-sm leading-relaxed text-white/50">
						Strategy · Identity · Website · Go-to-market · Promotion. Four upfront tiers from
						$3,500 — or pay monthly from $250.
					</p>
				</div>
				<span
					class="inline-flex shrink-0 items-center gap-2 rounded-sm border border-accent/50 px-5 py-2.5 text-sm font-bold whitespace-nowrap text-accent transition-all group-hover:bg-accent group-hover:text-white hover:bg-accent hover:text-white"
					set:html={`Explore BrandRise™ ${ArrowRight}`}
				/>
			</div>
		</a>
	)
}
