---
// Minimal transparent-header layout used by the 4 paid-ad landing pages.
// Mirrors the live site's `jy` wrapper component: no global nav, just a
// logo + phone number floating over the hero, and a stripped-down footer.
import Layout from "../../layouts/Layout.astro";
import FinanceDeferredChatWidget from "./FinanceDeferredChatWidget.tsx";

interface Props {
	title: string;
	description?: string;
	hideFooterInfo?: boolean;
}
const { title, description, hideFooterInfo = false } = Astro.props;
---

<Layout title={title} description={description} bare hideChat noindex>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
	<div class="fin-site flex min-h-screen flex-col bg-warmwhite font-sans text-nearblack">
		<header class="absolute top-0 right-0 left-0 z-50 bg-transparent py-6">
			<div class="container mx-auto flex items-center justify-between px-6">
				<a href="/" class="flex items-center gap-3">
					<img src="/images/finance/washington-silhouette.png" alt="WAFS Logo" class="h-8 w-8 brightness-0 invert" />
					<span class="font-display hidden text-xl font-semibold tracking-tight text-warmwhite sm:block">WAFS</span>
				</a>
				<a href="tel:2065555555" class="flex items-center gap-2 text-sm font-medium text-warmwhite transition-colors hover:text-warmwhite/80">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.812 1.6l-.468.35a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.404 6.385Z"></path>
					</svg>
					(206) 555-5555
				</a>
			</div>
		</header>
		<main class="flex-1">
			<slot />
		</main>
		<footer class="bg-nearblack py-8 text-sm text-warmwhite/60">
			<div class="container mx-auto space-y-2 px-6 text-center">
				{!hideFooterInfo && <p>Washington Accounting &amp; Financial Services | 1420 Fifth Avenue, Suite 1200, Seattle, WA 98101 | (206) 555-5555</p>}
				<p>© 2025 Washington Accounting &amp; Financial Services. All rights reserved. | <a href="/finance/privacy-policy" class="underline hover:text-warmwhite">Privacy Policy</a></p>
			</div>
		</footer>
		<FinanceDeferredChatWidget client:idle />
	</div>
</Layout>

<style is:global>
	.fin-site {
		--color-warmwhite: #fafaf8;
		--color-nearblack: #1a202c;
		font-family: "Plus Jakarta Sans", system-ui, sans-serif;
	}
	.fin-site .font-display {
		font-family: "Inter", system-ui, sans-serif;
	}
	.fin-site .bg-warmwhite {
		background-color: #fafaf8;
	}
	.fin-site .text-warmwhite {
		color: #fafaf8;
	}
	.fin-site .text-nearblack {
		color: #1a202c;
	}
	.fin-site .bg-nearblack {
		background-color: #1a202c;
	}
	.fin-site .text-wafs-forest {
		color: #1b3a2a;
	}
	.fin-site .bg-wafs-forest {
		background-color: #1b3a2a;
	}
	.fin-site .text-wafs-evergreen {
		color: #2d6a4f;
	}
	.fin-site .bg-wafs-evergreen {
		background-color: #2d6a4f;
	}
	.fin-site .text-wafs-gold {
		color: #c9a84c;
	}
	.fin-site .bg-wafs-gold {
		background-color: #c9a84c;
	}
	.fin-site .text-wafs-slate {
		color: #2c5282;
	}
	.fin-site .bg-wafs-slate {
		background-color: #2c5282;
	}
	.fin-site .bg-warmcream {
		background-color: #f0ede8;
	}
	.fin-site .border-lightsage {
		border-color: #d4e6dc;
	}
	.fin-site .text-charcoal {
		color: #4a5568;
	}
</style>
