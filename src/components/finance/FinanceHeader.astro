---
import FinanceLogo from "./FinanceLogo.astro";

const isHome = Astro.url.pathname === "/finance" || Astro.url.pathname === "/finance/";

const services = [
	{ title: "Tax Strategy & Compliance", href: "/finance/services/tax-strategy" },
	{ title: "Business Advisory & CFO Services", href: "/finance/services/business-advisory" },
	{ title: "Audit & Assurance", href: "/finance/services/audit-assurance" },
	{ title: "Wealth & Financial Planning", href: "/finance/services/wealth-planning" },
];
const industries = [
	{ title: "Technology & Startups", href: "/finance/industries/technology-startups" },
	{ title: "Real Estate", href: "/finance/industries/real-estate" },
	{ title: "Healthcare & Medical Practices", href: "/finance/industries/healthcare" },
	{ title: "Nonprofits & Foundations", href: "/finance/industries/nonprofits" },
	{ title: "Professional Services", href: "/finance/industries/professional-services" },
	{ title: "Family-Owned Business", href: "/finance/industries/family-business" },
];

const ChevronDown = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>`;
const Menu = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg>`;
const X = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>`;
---

<header
	id="fin-header"
	class:list={["fixed top-0 right-0 left-0 z-50 border-b transition-all duration-300", isHome ? "fin-header-home bg-transparent border-transparent" : "border-[#c7d9cb] bg-warmwhite shadow-sm"]}
>
	<div class="container mx-auto flex h-20 items-center justify-between px-6">
		<FinanceLogo light={isHome} />

		<div class="hidden items-center gap-8 lg:flex">
			<div class="relative fin-dropdown">
				<button
					type="button"
					class:list={["fin-nav-link flex items-center gap-1", isHome ? "text-warmwhite fin-nav-link-inverted" : "text-[#151a23]"]}
					data-dropdown-trigger="services"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Services
					<span class="h-4 w-4 transition-transform duration-200 fin-chevron" set:html={ChevronDown} />
				</button>
				<div class="absolute top-full left-0 pt-4 opacity-0 invisible pointer-events-none transition-all duration-200 fin-dropdown-panel" data-dropdown-panel="services">
					<ul class="grid w-[500px] grid-cols-2 gap-3 rounded-md border bg-white p-4 shadow-lg">
						<li class="row-span-2">
							<a href="/finance/services" class="flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b from-[#edebe8]/50 to-[#edebe8] p-6">
								<div class="font-display mt-4 mb-2 text-lg font-semibold text-wafs-forest">Integrated Services</div>
								<p class="text-sm leading-tight text-gray-500">Four services. One integrated strategy.</p>
							</a>
						</li>
						{services.map((s) => (
							<li><a href={s.href} class="block rounded-md p-3 text-sm font-medium leading-none text-nearblack hover:bg-[#edebe8]">{s.title}</a></li>
						))}
					</ul>
				</div>
			</div>
			<div class="relative fin-dropdown">
				<button
					type="button"
					class:list={["fin-nav-link flex items-center gap-1", isHome ? "text-warmwhite fin-nav-link-inverted" : "text-[#151a23]"]}
					data-dropdown-trigger="industries"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Industries
					<span class="h-4 w-4 transition-transform duration-200 fin-chevron" set:html={ChevronDown} />
				</button>
				<div class="absolute top-full left-0 pt-4 opacity-0 invisible pointer-events-none transition-all duration-200 fin-dropdown-panel" data-dropdown-panel="industries">
					<ul class="w-[500px] rounded-md border bg-white p-4 shadow-lg">
						<li class="col-span-2 mb-1">
							<a href="/finance/industries" class="block rounded-md p-4 hover:bg-[#edebe8]">
								<div class="font-display text-lg font-semibold text-wafs-forest">Industry Expertise</div>
								<p class="text-sm leading-tight text-gray-500">See all industries we serve.</p>
							</a>
						</li>
						<div class="grid grid-cols-2 gap-3">
							{industries.map((i) => (
								<li><a href={i.href} class="block rounded-md p-3 text-sm font-medium leading-none text-nearblack hover:bg-[#edebe8]">{i.title}</a></li>
							))}
						</div>
					</ul>
				</div>
			</div>
			<a href="/finance/team" class:list={["fin-nav-link", isHome ? "text-warmwhite fin-nav-link-inverted" : "text-[#151a23]"]}>Team</a>
			<div class="relative fin-dropdown">
				<button
					type="button"
					class:list={["fin-nav-link flex items-center gap-1", isHome ? "text-warmwhite fin-nav-link-inverted" : "text-[#151a23]"]}
					data-dropdown-trigger="resources"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Resources
					<span class="h-4 w-4 transition-transform duration-200 fin-chevron" set:html={ChevronDown} />
				</button>
				<div class="absolute top-full left-0 pt-4 opacity-0 invisible pointer-events-none transition-all duration-200 fin-dropdown-panel" data-dropdown-panel="resources">
					<ul class="w-[260px] rounded-md border bg-white p-4 shadow-lg">
						<li><a href="/finance/resources" class="block rounded-md p-3 hover:bg-[#edebe8]"><div class="mb-1 text-sm font-semibold">Resources Hub</div><p class="text-xs text-gray-500">Calculators, guides & downloads</p></a></li>
						<li><a href="/finance/resources/blog" class="block rounded-md p-3 hover:bg-[#edebe8]"><div class="mb-1 text-sm font-semibold">Blog & Insights</div><p class="text-xs text-gray-500">Tax, finance & advisory articles</p></a></li>
						<li><a href="/finance/faq" class="block rounded-md p-3 hover:bg-[#edebe8]"><div class="mb-1 text-sm font-semibold">FAQ</div><p class="text-xs text-gray-500">Common questions answered</p></a></li>
						<li class="mt-2 border-t border-[#c7d9cb] pt-2"><a href="/finance/about" class="block rounded-md p-3 hover:bg-[#edebe8]"><div class="mb-1 text-sm font-semibold">About WAFS</div><p class="text-xs text-gray-500">Our story, values & team</p></a></li>
						<li><a href="/finance/about/community" class="block rounded-md p-3 hover:bg-[#edebe8]"><div class="mb-1 text-sm font-semibold">Community</div><p class="text-xs text-gray-500">Our commitment to Seattle</p></a></li>
						<li><a href="/finance/about/careers" class="block rounded-md p-3 hover:bg-[#edebe8]"><div class="mb-1 text-sm font-semibold">Careers</div><p class="text-xs text-gray-500">Join the WAFS team</p></a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="hidden items-center gap-6 border-l border-white/20 pl-6 lg:flex">
			<a href="/finance/contact" class="rounded-md bg-wafs-gold px-5 py-2.5 font-semibold text-wafs-forest transition-colors hover:bg-wafs-gold/90">Schedule a Call</a>
		</div>

		<button type="button" id="fin-mobile-toggle" class="-mr-2 p-2 lg:hidden" aria-label="Toggle menu">
			<span class:list={["block h-6 w-6", isHome ? "text-warmwhite" : "text-wafs-forest"]} id="fin-mobile-icon-open" set:html={Menu} />
			<span class="hidden h-6 w-6 text-wafs-forest" id="fin-mobile-icon-close" set:html={X} />
		</button>
	</div>

	<div id="fin-mobile-menu" class="absolute top-0 left-0 hidden h-screen w-full overflow-y-auto bg-warmwhite px-6 pt-24">
		<div class="flex flex-col gap-6 pb-20">
			<div class="space-y-4">
				<h4 class="font-display text-lg font-semibold text-wafs-forest">Services</h4>
				<ul class="space-y-3 border-l border-[#c7d9cb] pl-4">
					<li><a href="/finance/services" class="block font-medium text-nearblack">All Services</a></li>
					{services.map((s) => (<li><a href={s.href} class="block text-[#3a3a3a]">{s.title}</a></li>))}
				</ul>
			</div>
			<div class="space-y-4">
				<h4 class="font-display text-lg font-semibold text-wafs-forest">Industries</h4>
				<ul class="space-y-3 border-l border-[#c7d9cb] pl-4">
					<li><a href="/finance/industries" class="block font-medium text-nearblack">All Industries</a></li>
					{industries.map((i) => (<li><a href={i.href} class="block text-[#3a3a3a]">{i.title}</a></li>))}
				</ul>
			</div>
			<a href="/finance/team" class="font-display block border-b border-[#c7d9cb] py-2 text-lg font-semibold text-wafs-forest">Team</a>
			<div class="space-y-4 border-b border-[#c7d9cb] pb-4">
				<h4 class="font-display text-lg font-semibold text-wafs-forest">Resources & About</h4>
				<ul class="space-y-3 border-l border-[#c7d9cb] pl-4">
					<li><a href="/finance/resources" class="block font-medium text-nearblack">Resources Hub</a></li>
					<li><a href="/finance/resources/blog" class="block text-[#3a3a3a]">Blog & Insights</a></li>
					<li><a href="/finance/faq" class="block text-[#3a3a3a]">FAQ</a></li>
					<li><a href="/finance/about" class="block text-[#3a3a3a]">About WAFS</a></li>
					<li><a href="/finance/about/community" class="block text-[#3a3a3a]">Community</a></li>
					<li><a href="/finance/about/careers" class="block text-[#3a3a3a]">Careers</a></li>
				</ul>
			</div>
			<div class="flex flex-col gap-4 pt-6">
				<a href="/finance/contact" class="w-full rounded-md bg-wafs-gold px-5 py-3 text-center font-semibold text-wafs-forest hover:bg-wafs-gold/90">Schedule a Call</a>
			</div>
		</div>
	</div>
</header>

<style>
	/* Static, state-independent styling only. Anything that depends on a JS-added
	   class (scroll position, open/closed dropdowns, the mobile menu) is handled
	   below by toggling plain utility classes directly on the affected elements
	   instead — a scoped selector like `.fin-header-home.fin-scrolled` only ever
	   matches after user interaction, so the production build's critical-CSS step
	   (which crawls the page in its initial, un-interacted state) silently drops
	   any rule that depends on one. Plain classes don't have this problem because
	   they're already present verbatim elsewhere in the page's markup, so the
	   build always considers them in use. */
	.fin-nav-link {
		font-size: 0.9375rem;
		font-weight: 500;
		transition: color 0.2s;
	}
	/* Plain, unconditional hover rules (no ancestor/state selector involved) — these
	   survive the critical-CSS step fine on their own, same as any other :hover
	   rule on a static class. `.fin-nav-link-inverted` is a marker class toggled
	   via JS in the script below, not a compound selector, so its own :hover rule
	   is equally safe; declaring it after `.fin-nav-link:hover` lets it win via
	   source order whenever both classes are present on the same element. */
	.fin-nav-link:hover {
		color: #1b3a2a;
	}
	.fin-nav-link-inverted:hover {
		color: rgba(250, 250, 248, 0.8);
	}
</style>

<script>
	const header = document.getElementById("fin-header");
	const isHome = header?.classList.contains("fin-header-home");
	const navLinks = header?.querySelectorAll<HTMLElement>(".fin-nav-link") ?? [];
	const mobileIconOpen = document.getElementById("fin-mobile-icon-open");
	const logoMask = header?.querySelector<HTMLElement>(".fin-logo-mask");
	const logoTexts = header?.querySelectorAll<HTMLElement>(".fin-logo-text") ?? [];

	function setScrolled(isScrolled: boolean) {
		if (!header) return;
		header.classList.toggle("bg-transparent", !isScrolled);
		header.classList.toggle("border-transparent", !isScrolled);
		header.classList.toggle("bg-warmwhite", isScrolled);
		header.classList.toggle("border-[#c7d9cb]", isScrolled);
		header.classList.toggle("shadow-sm", isScrolled);

		navLinks.forEach((link) => {
			link.classList.toggle("text-warmwhite", !isScrolled);
			link.classList.toggle("fin-nav-link-inverted", !isScrolled);
			link.classList.toggle("text-[#151a23]", isScrolled);
		});
		mobileIconOpen?.classList.toggle("text-warmwhite", !isScrolled);
		mobileIconOpen?.classList.toggle("text-wafs-forest", isScrolled);
		logoTexts.forEach((el) => {
			el.classList.toggle("text-warmwhite", !isScrolled);
			el.classList.toggle("text-wafs-forest", isScrolled);
		});
		if (logoMask) logoMask.style.backgroundColor = isScrolled ? "#1b3a2a" : "#ffffff";
	}

	function onScroll() {
		if (!header || !isHome) return;
		setScrolled(window.scrollY > 20);
	}
	window.addEventListener("scroll", onScroll);
	onScroll();

	function closeDropdown(wrapper: Element) {
		const panel = wrapper.querySelector<HTMLElement>("[data-dropdown-panel]");
		const chevron = wrapper.querySelector<HTMLElement>(".fin-chevron");
		panel?.classList.add("opacity-0", "invisible", "pointer-events-none");
		panel?.classList.remove("opacity-100", "visible", "pointer-events-auto");
		chevron?.classList.remove("rotate-180");
		wrapper.classList.remove("fin-open");
	}
	function openDropdown(wrapper: Element) {
		const panel = wrapper.querySelector<HTMLElement>("[data-dropdown-panel]");
		const chevron = wrapper.querySelector<HTMLElement>(".fin-chevron");
		panel?.classList.remove("opacity-0", "invisible", "pointer-events-none");
		panel?.classList.add("opacity-100", "visible", "pointer-events-auto");
		chevron?.classList.add("rotate-180");
		wrapper.classList.add("fin-open");
	}
	document.querySelectorAll<HTMLElement>("[data-dropdown-trigger]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const wrapper = btn.closest(".fin-dropdown");
			if (!wrapper) return;
			const isOpen = wrapper.classList.contains("fin-open");
			document.querySelectorAll(".fin-dropdown").forEach((d) => closeDropdown(d));
			if (!isOpen) openDropdown(wrapper);
		});
	});
	document.addEventListener("click", (e) => {
		if (!(e.target as HTMLElement).closest(".fin-dropdown")) {
			document.querySelectorAll(".fin-dropdown").forEach((d) => closeDropdown(d));
		}
	});

	const mobileToggle = document.getElementById("fin-mobile-toggle");
	const mobileMenu = document.getElementById("fin-mobile-menu");
	const iconOpen = document.getElementById("fin-mobile-icon-open");
	const iconClose = document.getElementById("fin-mobile-icon-close");
	mobileToggle?.addEventListener("click", () => {
		const isOpen = mobileMenu?.classList.toggle("fin-open");
		mobileMenu?.classList.toggle("hidden", !isOpen);
		mobileMenu?.classList.toggle("block", !!isOpen);
		iconOpen?.classList.toggle("hidden", isOpen);
		iconClose?.classList.toggle("hidden", !isOpen);
	});
</script>
